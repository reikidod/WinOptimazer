<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AssemblyName>WinOptimizer.DeviceCoreManager</AssemblyName>
    <RootNamespace>WinOptimizer.DeviceCoreManager</RootNamespace>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile the same source file used by the WPF app; keep one implementation without a GUI dependency. -->
    <Compile Include="..\Services\InterruptAffinityService.cs" Link="Services\InterruptAffinityService.cs" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>
</Project>
