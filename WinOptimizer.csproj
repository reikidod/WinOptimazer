<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- Запуск: без фонового GC-потока и с быстрой ступенью JIT -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>WinOptimizer</AssemblyName>
    <RootNamespace>WinOptimizer</RootNamespace>
    <Version>0.4.25</Version>
    <AssemblyVersion>0.4.25.0</AssemblyVersion>
    <FileVersion>0.4.25.0</FileVersion>
    <!-- Метка канала: CI передаёт stable (ветка main) или beta (ветка beta); локальная сборка — dev. Показывается в приложении: v0.4.12-beta. -->
    <ReleaseChannel Condition="'$(ReleaseChannel)' == ''">dev</ReleaseChannel>
    <InformationalVersion Condition="'$(ReleaseChannel)' != ''">$(Version)-$(ReleaseChannel)</InformationalVersion>
    <InformationalVersion Condition="'$(ReleaseChannel)' == ''">$(Version)</InformationalVersion>
    <Product>WinOptimizer</Product>
    <AssemblyTitle>WinOptimizer</AssemblyTitle>
    <Description>Open-source Windows optimizer (MIT). Tweaks, debloat, Zapret helper.</Description>
    <Company>WinOptimizer Contributors</Company>
    <Authors>WinOptimizer Contributors</Authors>
    <Copyright>Copyright (c) 2026 WinOptimizer Contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/reikidod/WinOptimazer</PackageProjectUrl>
    <NeutralLanguage>ru-RU</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <!-- Тесты лежат внутри папки проекта: не даём SDK собрать их в само приложение. -->
    <Compile Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
    <None Remove="tests\**" />
    <Page Remove="tests\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- В WPF-проектах SDK исключает System.IO из неявных using (конфликт Path с System.Windows.Shapes.Path), возвращаем его. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <None Include="LICENSE" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WinOptimizer.Tests" />
  </ItemGroup>

</Project>
