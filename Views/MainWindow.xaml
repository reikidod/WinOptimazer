<Window x:Class="WinOptimizer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WinOptimizer.Views"
        Title="WinOptimizer"
        Width="1240" Height="820" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{DynamicResource BgWindowBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="14"
        UseLayoutRounding="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:CardWidthConverter x:Key="CardWidth" />

    </Window.Resources>

    <Grid x:Name="RootGrid" ClipToBounds="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Пользовательский фон: картинка с размытием и затемняющий слой цвета темы (под всеми страницами) -->
        <!-- Картинка всегда в исходном масштабе: blur её не увеличивает, края просто обрезаются клипом -->
        <Grid Grid.ColumnSpan="2" ClipToBounds="True" IsHitTestVisible="False">
            <Image x:Name="BackgroundImage" Stretch="UniformToFill" Visibility="Collapsed"
                   RenderOptions.BitmapScalingMode="HighQuality">
                <Image.Effect>
                    <BlurEffect x:Name="BackgroundBlur" Radius="0" KernelType="Gaussian" RenderingBias="Performance" />
                </Image.Effect>
                <Image.CacheMode>
                    <BitmapCache EnableClearType="False" RenderAtScale="1" />
                </Image.CacheMode>
            </Image>
            <Rectangle x:Name="BackgroundDim" Fill="{DynamicResource BgWindowBrush}"
                       Opacity="0" Visibility="Collapsed" />
        </Grid>

        <!-- ============ Боковая панель ============ -->
        <Border Background="{DynamicResource BgSidebarBrush}" Panel.ZIndex="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="0" Opacity="0.5" Color="Black" />
            </Border.Effect>
            <Grid Margin="16,24,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="6,0,0,28">
                    <TextBlock Text="WinOptimizer" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Оптимизация Windows 10/11" Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <RadioButton Style="{StaticResource NavButton}" GroupName="Pages"
                                 IsChecked="{Binding IsHomePage, Mode=TwoWay}"
                                 AutomationProperties.Name="Страница «Главная»">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Data="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Главная" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="Pages"
                                 IsChecked="{Binding IsTweaksPage, Mode=TwoWay}"
                                 Visibility="{Binding Settings.ShowTweaksTab, Converter={StaticResource BoolToVis}}"
                                 AutomationProperties.Name="Страница «Твики»">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Data="M13 3L4 14h7l-1 7 9-11h-7l1-7z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Оптимизация системы" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <!-- REST_OF_FILE_CONTINUES_IN_NEXT_COMMIT -->
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
