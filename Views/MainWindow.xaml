<Window x:Class="WinOptimizer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WinOptimizer.Views"
        Title="WinOptimizer"
        Width="1240" Height="820" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{DynamicResource BgWindowBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="14"
        UseLayoutRounding="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:CardWidthConverter x:Key="CardWidth" />
        <Style x:Key="DashboardCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BgCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="18,17" />
            <Setter Property="Margin" Value="0,0,12,10" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="3" Direction="270" Opacity="0.18" Color="Black" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BgCardHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Компактная кнопка управления панелью: направление показывает следующее действие. -->
        <Style x:Key="SidebarToggleButton" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Content" Value="‹" />
            <Setter Property="ToolTip" Value="Свернуть боковую панель (Ctrl+B)" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource BgCardHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                    <Setter Property="Content" Value="›" />
                    <Setter Property="ToolTip" Value="Развернуть боковую панель (Ctrl+B)" />
                </DataTrigger>
            </Style.Triggers>
        </Style>



        <!-- Навигация: компактная рейка с иконками или полная панель с подписями. -->
        <Style x:Key="SidebarNavigationButton" TargetType="RadioButton" BasedOn="{StaticResource NavButton}">
            <Setter Property="Width" Value="54" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Width" Value="208" />
                    <Setter Property="Padding" Value="12,0" />
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SidebarNavigationIcon" TargetType="Viewbox">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Margin" Value="0,0,12,0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="B" Modifiers="Control" Command="{Binding ToggleSidebarCommand}" />
    </Window.InputBindings>

    <Grid x:Name="RootGrid" ClipToBounds="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Пользовательский фон: картинка с размытием и затемняющий слой цвета темы (под всеми страницами) -->
        <!-- Картинка всегда в исходном масштабе: blur её не увеличивает, края просто обрезаются клипом -->
        <Grid Grid.ColumnSpan="2" ClipToBounds="True" IsHitTestVisible="False">
            <Image x:Name="BackgroundImage" Stretch="UniformToFill" Visibility="Collapsed"
                   RenderOptions.BitmapScalingMode="HighQuality">
                <Image.Effect>
                    <BlurEffect x:Name="BackgroundBlur" Radius="0" KernelType="Gaussian" RenderingBias="Performance" />
                </Image.Effect>
                <Image.CacheMode>
                    <BitmapCache EnableClearType="False" RenderAtScale="1" />
                </Image.CacheMode>
            </Image>
            <Rectangle x:Name="BackgroundDim" Fill="{DynamicResource BgWindowBrush}"
                       Opacity="0" Visibility="Collapsed" />

            <!-- Фирменная атмосфера сайта: едва заметная сетка и мягкие красно-синие свечения. -->
            <Rectangle Fill="{DynamicResource SiteGridBrush}" Opacity="0.72" />
            <Ellipse Width="680" Height="680" HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,-340,-260,0" Fill="{DynamicResource SiteRedGlowBrush}" Opacity="0.78" />
            <Ellipse Width="560" Height="560" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                     Margin="-280,0,0,-280" Fill="{DynamicResource SiteBlueGlowBrush}" Opacity="0.72" />
        </Grid>

        <!-- ============ Боковая панель ============ -->
        <Border x:Name="SidebarPanel" Background="{DynamicResource BgSidebarBrush}" Panel.ZIndex="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="0" Opacity="0.28" Color="Black" />
            </Border.Effect>
            <Grid Margin="10,20,10,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel HorizontalAlignment="Stretch" Margin="0,0,0,22">
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="42" Height="42" Margin="0" CornerRadius="12" ToolTip="{Binding VersionLabel}"
                                    Background="{DynamicResource BgCardBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Viewbox Width="30" Height="30" Stretch="Uniform">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M2 6 H5.4 L7.8 17 L10.2 6 H13.8 L16.2 17 L18.6 6 H22 L18 20 H14.8 L12 11.6 L9.2 20 H6 Z"
                                                  Fill="{DynamicResource BrandGradientBrush}" />
                                            <Path Data="M12.8 6 H16 L11.1 20 H7.9 Z"
                                                  Fill="{DynamicResource BrandRedBrush}" />
                                        </Canvas>
                                    </Viewbox>
                                </Grid>
                            </Border>
                            <TextBlock Text="WinOptimizer" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Margin="10,0,0,0"
                                       Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource SidebarToggleButton}"
                                Command="{Binding ToggleSidebarCommand}"
                                AutomationProperties.Name="Переключить режим боковой панели"
                                AutomationProperties.HelpText="Свернуть или развернуть боковую панель. Также доступно сочетание Ctrl+B." />
                    </Grid>
                    <TextBlock Text="Оптимизация Windows 10/11" Style="{StaticResource SecondaryText}" FontSize="12"
                               Margin="2,0,0,0"
                               Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <RadioButton Style="{StaticResource SidebarNavigationButton}" GroupName="Pages"
                                 IsChecked="{Binding IsDashboardPage, Mode=TwoWay}"
                                 AutomationProperties.Name="Главная панель"
                                 ToolTip="Главная">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="20" Height="20" Style="{StaticResource SidebarNavigationIcon}" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Data="M3 10.5L12 3l9 7.5v9a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 19.5z M9 21v-7h6v7" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Главная" VerticalAlignment="Center" Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource SidebarNavigationButton}" GroupName="Pages"
                                 IsChecked="{Binding IsTweaksPage, Mode=TwoWay}"
                                 Visibility="{Binding Settings.ShowTweaksTab, Converter={StaticResource BoolToVis}}"
                                 AutomationProperties.Name="Страница «Твики»"
                                 ToolTip="Оптимизация">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="20" Height="20" Style="{StaticResource SidebarNavigationIcon}" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Data="M13 3L4 14h7l-1 7 9-11h-7l1-7z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Оптимизация" VerticalAlignment="Center" Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource SidebarNavigationButton}" GroupName="HiddenPages"
                                 IsChecked="{Binding IsDebloatPage, Mode=TwoWay}"
                                 Visibility="Collapsed"
                                 AutomationProperties.Name="Страница «Лишние приложения»">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="20" Height="20" Style="{StaticResource SidebarNavigationIcon}" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Удаление программ" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource SidebarNavigationButton}" GroupName="Pages"
                                 IsChecked="{Binding IsApplicationsGroupPage, Mode=TwoWay}"
                                 Visibility="{Binding Settings.ShowApplicationsGroup, Converter={StaticResource BoolToVis}}"
                                 AutomationProperties.Name="Страница «Приложения»"
                                 ToolTip="Приложения">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="20" Height="20" Style="{StaticResource SidebarNavigationIcon}" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Приложения" VerticalAlignment="Center" Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource SidebarNavigationButton}" GroupName="HiddenPages"
                                 IsChecked="{Binding IsStorePage, Mode=TwoWay}"
                                 Visibility="Collapsed"
                                 AutomationProperties.Name="Страница «MS Store»">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="20" Height="20" Style="{StaticResource SidebarNavigationIcon}" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Data="M4 4h7v7H4V4zm9 0h7v7h-7V4zM4 13h7v7H4v-7zm9 0h7v7h-7v-7z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Microsoft Store" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource SidebarNavigationButton}" GroupName="Pages"
                                 IsChecked="{Binding IsGamesPage, Mode=TwoWay}"
                                 Visibility="{Binding Settings.ShowGamesTab, Converter={StaticResource BoolToVis}}"
                                 AutomationProperties.Name="Страница «Игры»"
                                 ToolTip="Игры">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="20" Height="20" Style="{StaticResource SidebarNavigationIcon}" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Data="M21 6H3c-1.1 0-2 .9-2 2v8c0 1.1.9 2 2 2h18c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-10 7H8v3H6v-3H3v-2h3V8h2v3h3v2zm4.5 2c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm4-3c-.83 0-1.5-.67-1.5-1.5S18.67 9 19.5 9s1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Игры" VerticalAlignment="Center" Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource SidebarNavigationButton}" GroupName="Pages"
                                 IsChecked="{Binding IsSystemPage, Mode=TwoWay}"
                                 Visibility="{Binding Settings.ShowSystemTab, Converter={StaticResource BoolToVis}}"
                                 AutomationProperties.Name="Страница «Производительность»"
                                 ToolTip="Мой ПК">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="20" Height="20" Style="{StaticResource SidebarNavigationIcon}" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Data="M20 18c1.1 0 1.99-.9 1.99-2L22 6c0-1.1-.9-2-2-2H4c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2H0v2h24v-2h-4zM4 6h16v10H4V6z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Мой ПК" VerticalAlignment="Center" Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource SidebarNavigationButton}" GroupName="Pages"
                                 IsChecked="{Binding IsMaintenancePage, Mode=TwoWay}"
                                 Visibility="{Binding Settings.ShowMaintenanceTab, Converter={StaticResource BoolToVis}}"
                                 AutomationProperties.Name="Страница «Обслуживание»"
                                 ToolTip="Обслуживание">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="20" Height="20" Style="{StaticResource SidebarNavigationIcon}" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Data="M15.55 13c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.37-.66-.11-1.48-.87-1.48H5.21l-.94-2H1v2h2l3.6 7.59-1.35 2.44C4.52 15.37 5.48 17 7 17h12v-2H7l1.1-2h7.45zM6.16 6h12.15l-2.76 5H8.53L6.16 6zM7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zm10 0c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Обслуживание" VerticalAlignment="Center" Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource SidebarNavigationButton}" GroupName="Pages"
                                 IsChecked="{Binding IsSettingsPage, Mode=TwoWay}"
                                 AutomationProperties.Name="Страница «Настройки»"
                                 ToolTip="Настройки">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="20" Height="20" Style="{StaticResource SidebarNavigationIcon}" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58a.49.49 0 00.12-.61l-1.92-3.32a.488.488 0 00-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54a.484.484 0 00-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58a.49.49 0 00-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Настройки" VerticalAlignment="Center" Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- Иконки + версия + обновление -->
                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="4,0,4,12" Opacity="0.55" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Width="32" Height="32" Margin="2,0" Padding="0" Cursor="Hand"
                                Background="Transparent" BorderThickness="0"
                                Command="{Binding OpenLinkCommand}"
                                CommandParameter="https://reikidod.github.io/WinOptimazer-site/"
                                ToolTip="Официальный сайт WinOptimizer"
                                AutomationProperties.Name="Официальный сайт WinOptimizer">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg" Background="Transparent" CornerRadius="10" Width="40" Height="40">
                                        <Viewbox Width="20" Height="20">
                                            <Canvas Width="24" Height="24">
                                                <Path Fill="{DynamicResource TextSecondaryBrush}"
                                                      Data="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm0 2c1.5 1.8 2.4 4.5 2.6 7h-5.2c.2-2.5 1.1-5.2 2.6-7zm-4 1.1C6.6 6.7 5.7 8.8 5.4 11H3.1c.3-2.5 2.1-4.8 4.9-5.9zM3.1 13h2.3c.3 2.2 1.2 4.3 2.6 5.9-2.8-1.1-4.6-3.4-4.9-5.9zm8.9 7c-1.5-1.8-2.4-4.5-2.6-7h5.2c-.2 2.5-1.1 5.2-2.6 7zm4-1.1c1.4-1.6 2.3-3.7 2.6-5.9h2.3c-.3 2.5-2.1 4.8-4.9 5.9zM18.6 11c-.3-2.2-1.2-4.3-2.6-5.9 2.8 1.1 4.6 3.4 4.9 5.9h-2.3z" />
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource BgCardHoverBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Width="32" Height="32" Margin="2,0" Padding="0" Cursor="Hand"
                                Background="Transparent" BorderThickness="0"
                                Command="{Binding OpenLinkCommand}"
                                CommandParameter="https://github.com/reikidod/WinOptimazer"
                                ToolTip="GitHub · reikidod/WinOptimazer"
                                AutomationProperties.Name="GitHub">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg" Background="Transparent" CornerRadius="10" Width="40" Height="40">
                                        <Viewbox Width="20" Height="20">
                                            <Canvas Width="24" Height="24">
                                                <Path Fill="{DynamicResource TextSecondaryBrush}"
                                                      Data="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0022 12.017C22 6.484 17.522 2 12 2z" />
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource BgCardHoverBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="{Binding VersionLabel}" HorizontalAlignment="Center"
                               FontSize="11" Margin="0,8,0,2" Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                               Foreground="{DynamicResource TextDimBrush}"
                               ToolTip="{Binding UpdateStatus}" />
                    <Button Content="↻" Width="40" Height="40" HorizontalAlignment="Center"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            FontSize="18" Padding="0" Margin="0,0,0,4"
                            Foreground="{DynamicResource AccentBrush}"
                            Command="{Binding CheckUpdateCommand}"
                            ToolTip="{Binding UpdateButtonToolTip}"
                            AutomationProperties.HelpText="Проверить обновления и установить их заменой файлов без нового Setup">
                        <Button.ContextMenu>
                            <ContextMenu Style="{StaticResource DarkContextMenu}">
                                <MenuItem Style="{StaticResource DarkMenuItem}" Header="Проверить наличие обновлений"
                                          Command="{Binding PlacementTarget.DataContext.CheckUpdateCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Style="{StaticResource DarkMenuItem}" Header="Скачать и установить обновление"
                                          Command="{Binding PlacementTarget.DataContext.ApplyUpdateCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          IsEnabled="{Binding PlacementTarget.DataContext.UpdateAvailable, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          ToolTip="Доступно после успешной проверки обновлений" />
                                <Separator Style="{StaticResource DarkMenuSeparator}" />
                                <MenuItem Style="{StaticResource DarkMenuItem}" Header="Открыть страницу релизов GitHub"
                                          Command="{Binding PlacementTarget.DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="https://github.com/reikidod/WinOptimazer/releases" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <TextBlock Text="{Binding UpdateStatus}" HorizontalAlignment="Center"
                               FontSize="10" TextWrapping="Wrap" TextAlignment="Center"
                               Margin="4,0,4,0" MaxWidth="200" Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                               Foreground="{DynamicResource TextDimBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ Содержимое ============ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Главная: обновлённый центр управления Windows -->
            <Grid Visibility="{Binding IsDashboardPage, Converter={StaticResource BoolToVis}}"
                  local:Motion.PageTransition="True" Margin="28,22,22,12">
                <ScrollViewer Style="{StaticResource OverlayScroll}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,6,12" Focusable="False">
                    <StackPanel Margin="0,0,8,12">
                        <!-- Приветственный блок и основные действия -->
                        <Border Background="{DynamicResource BgCardBrush}"
                                BorderBrush="{DynamicResource BorderHoverBrush}" BorderThickness="1"
                                CornerRadius="20" Padding="24" Margin="0,0,0,18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="250" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                    <TextBlock Text="WINOPTIMIZER  /  CONTROL CENTER"
                                               FontSize="10.5" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}" />
                                    <TextBlock Text="Всё под контролем."
                                               FontSize="30" FontWeight="SemiBold"
                                               Margin="0,8,0,0" />
                                    <TextBlock Text="Управляйте производительностью, играми и обслуживанием Windows из одного места."
                                               Style="{StaticResource SecondaryText}" FontSize="13"
                                               TextWrapping="Wrap" MaxWidth="620" Margin="0,5,0,0" />
                                    <TextBlock Text="{Binding DiagnosticSummary}"
                                               FontSize="12.5" FontWeight="Medium"
                                               TextWrapping="Wrap" Margin="0,14,0,0" />
                                    <TextBlock Text="{Binding DiagnosticLastRunText}"
                                               Style="{StaticResource SecondaryText}" FontSize="11" Margin="0,5,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="{DynamicResource BgCardHoverBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="15" Padding="16">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="СОСТОЯНИЕ СИСТЕМЫ" FontSize="10"
                                                   FontWeight="Bold" Foreground="{DynamicResource TextDimBrush}" />
                                        <TextBlock Text="{Binding DashboardStatus}" FontSize="13"
                                                   FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,7,0,14" />
                                        <Button Content="Проверить систему" Style="{StaticResource AccentButton}"
                                                Command="{Binding RunDiagnosticsCommand}" Padding="14,10" />
                                        <Button Content="Характеристики ПК" Margin="0,8,0,0"
                                                Command="{Binding NavigateCommand}" CommandParameter="System" />
                                        <Button Content="Обновить данные" Margin="0,8,0,0"
                                                Command="{Binding RefreshDashboardCommand}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Живые показатели: карточки с локальной историей и мини-графиками -->
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- CPU -->
                            <Border Grid.Column="0" Style="{StaticResource DashboardCard}" Margin="0,0,6,0"
                                    MinHeight="194" Padding="15,14">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="ПРОЦЕССОР" FontSize="10" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextDimBrush}" />
                                        <Border Grid.Column="1" Width="8" Height="8" CornerRadius="4"
                                                Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="{Binding DashboardSnapshot.CpuSummary, TargetNullValue='…'}"
                                               FontSize="31" FontWeight="SemiBold" Margin="0,8,0,0" />
                                    <TextBlock Text="{Binding DashboardSnapshot.CpuLoadSubtitle}"
                                               Style="{StaticResource SecondaryText}" FontSize="10.5" />
                                    <ProgressBar Margin="0,10,0,0" Height="5" Maximum="100"
                                                 IsIndeterminate="{Binding DashboardSnapshot.CpuProgressIsIndeterminate}"
                                                 Value="{Binding DashboardSnapshot.CpuProgressValue, Mode=OneWay}" />
                                    <TextBlock Text="ДИНАМИКА · ПОСЛЕДНИЕ ЗАМЕРЫ" FontSize="8.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextDimBrush}" Margin="0,13,0,5" />
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding PerformanceHistory}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Width="4" Height="38" Margin="0,0,2,0" ToolTip="{Binding TooltipText}">
                                                        <Border Background="{DynamicResource TrackOffBrush}" CornerRadius="2" />
                                                        <Border Height="{Binding CpuBarHeight}" VerticalAlignment="Bottom"
                                                                Background="{DynamicResource AccentBrush}" Opacity="{Binding CpuBarOpacity}"
                                                                CornerRadius="2" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>

                            <!-- RAM -->
                            <Border Grid.Column="1" Style="{StaticResource DashboardCard}" Margin="3,0"
                                    MinHeight="194" Padding="15,14">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="ОПЕРАТИВНАЯ ПАМЯТЬ" FontSize="10" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextDimBrush}" />
                                        <Border Grid.Column="1" Width="8" Height="8" CornerRadius="4"
                                                Background="{DynamicResource BrandGradientBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="{Binding DashboardSnapshot.MemoryLoadValue, TargetNullValue='…'}"
                                               FontSize="31" FontWeight="SemiBold" Margin="0,8,0,0" />
                                    <TextBlock Text="{Binding DashboardSnapshot.MemoryUsageSubtitle}"
                                               Style="{StaticResource SecondaryText}" FontSize="10.5" />
                                    <ProgressBar Margin="0,10,0,0" Height="5" Maximum="100"
                                                 Value="{Binding DashboardSnapshot.MemoryLoadPercent, Mode=OneWay}" />
                                    <TextBlock Text="ИСПОЛЬЗОВАНИЕ RAM · ИСТОРИЯ" FontSize="8.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextDimBrush}" Margin="0,13,0,5" />
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding PerformanceHistory}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Width="4" Height="38" Margin="0,0,2,0" ToolTip="{Binding TooltipText}">
                                                        <Border Background="{DynamicResource TrackOffBrush}" CornerRadius="2" />
                                                        <Border Height="{Binding MemoryBarHeight}" VerticalAlignment="Bottom"
                                                                Background="{DynamicResource BrandGradientBrush}" CornerRadius="2" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>

                            <!-- GPU -->
                            <Border Grid.Column="2" Style="{StaticResource DashboardCard}" Margin="3,0"
                                    MinHeight="194" Padding="15,14">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="ВИДЕОКАРТА" FontSize="10" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextDimBrush}" />
                                        <Border Grid.Column="1" Width="8" Height="8" CornerRadius="4"
                                                Background="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding GpuActivity}" Margin="0,7,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding UtilizationText}" FontSize="27"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="10.5"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}" />
                                                    <ProgressBar Height="5" Margin="0,8,0,0" Maximum="100"
                                                                 IsIndeterminate="{Binding IsWarmingUp}"
                                                                 Value="{Binding UtilizationPercent}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="Данные GPU недоступны на этом устройстве"
                                               Style="{StaticResource SecondaryText}" FontSize="10.5"
                                               TextWrapping="Wrap" Margin="0,8,0,0"
                                               Visibility="{Binding HasNoGpuActivity, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="АКТИВНОСТЬ GPU · ИСТОРИЯ" FontSize="8.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextDimBrush}" Margin="0,13,0,5" />
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding PerformanceHistory}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Width="4" Height="38" Margin="0,0,2,0" ToolTip="{Binding TooltipText}">
                                                        <Border Background="{DynamicResource TrackOffBrush}" CornerRadius="2" />
                                                        <Border Height="{Binding GpuBarHeight}" VerticalAlignment="Bottom"
                                                                Background="{DynamicResource TextSecondaryBrush}"
                                                                Opacity="{Binding GpuBarOpacity}" CornerRadius="2" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>

                            <!-- Системный диск -->
                            <Border Grid.Column="3" Style="{StaticResource DashboardCard}" Margin="6,0,0,0"
                                    MinHeight="194" Padding="15,14">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="СИСТЕМНЫЙ ДИСК" FontSize="10" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextDimBrush}" />
                                        <Border Grid.Column="1" Width="8" Height="8" CornerRadius="4"
                                                Background="{DynamicResource AccentBrush}" Opacity="0.7"
                                                VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="{Binding DashboardSnapshot.DiskFreeText, TargetNullValue='…'}"
                                               FontSize="27" FontWeight="SemiBold" Margin="0,8,0,0" />
                                    <TextBlock Text="свободно" Style="{StaticResource SecondaryText}" FontSize="10.5" />
                                    <ProgressBar Margin="0,10,0,0" Height="5" Maximum="100"
                                                 Value="{Binding DashboardSnapshot.DiskFreePercent, Mode=OneWay}" />
                                    <TextBlock Style="{StaticResource SecondaryText}" FontSize="10"
                                               Margin="0,5,0,0" TextTrimming="CharacterEllipsis">
                                        <Run Text="из " />
                                        <Run Text="{Binding DashboardSnapshot.DiskTotalText, Mode=OneWay}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding DashboardSnapshot.SystemDrive, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="АКТИВНОСТЬ ДИСКОВ · ИСТОРИЯ" FontSize="8.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextDimBrush}" Margin="0,13,0,5" />
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding PerformanceHistory}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Width="4" Height="38" Margin="0,0,2,0" ToolTip="{Binding TooltipText}">
                                                        <Border Background="{DynamicResource TrackOffBrush}" CornerRadius="2" />
                                                        <Border Height="{Binding DiskBarHeight}" VerticalAlignment="Bottom"
                                                                Background="{DynamicResource AccentBrush}" Opacity="{Binding DiskBarOpacity}"
                                                                CornerRadius="2" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Все накопители -->
                        <Border Style="{StaticResource DashboardCard}" Margin="0,0,0,16" Padding="18">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Хранилища" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="Свободное место на всех подключённых дисках"
                                                   Style="{StaticResource SecondaryText}" FontSize="11" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Подробности"
                                            Command="{Binding NavigateCommand}" CommandParameter="System" />
                                </Grid>
                                <TextBlock Text="Дополнительные диски не обнаружены"
                                           Visibility="{Binding HasNoAdditionalDrives, Converter={StaticResource BoolToVis}}"
                                           Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />
                                <ItemsControl ItemsSource="{Binding AdditionalDrives}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="230" Margin="0,0,10,8" Padding="13"
                                                    Background="{DynamicResource BgCardHoverBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding StorageTypeText}" Style="{StaticResource SecondaryText}"
                                                               FontSize="10.5" Margin="0,3,0,8" />
                                                    <ProgressBar Maximum="100" Value="{Binding UsedPercent, Mode=OneWay}" Height="7" />
                                                    <TextBlock Text="{Binding UsageSummary, Mode=OneWay}" Margin="0,7,0,0"
                                                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Основные разделы -->
                        <Grid Margin="0,0,0,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Быстрый доступ" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                            <UniformGrid Grid.Row="1" Columns="4">
                                <Button Margin="0,0,7,0" Padding="15,16" HorizontalContentAlignment="Left"
                                        Command="{Binding NavigateCommand}" CommandParameter="Tweaks">
                                    <StackPanel>
                                        <TextBlock Text="Оптимизация" FontWeight="SemiBold" />
                                        <TextBlock Text="Режимы и системные настройки" Style="{StaticResource SecondaryText}"
                                                   FontSize="10.5" TextWrapping="Wrap" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button Margin="3,0" Padding="15,16" HorizontalContentAlignment="Left"
                                        Command="{Binding NavigateCommand}" CommandParameter="Games">
                                    <StackPanel>
                                        <TextBlock Text="Игры" FontWeight="SemiBold" />
                                        <TextBlock Text="Профили, GPU и Game Boost" Style="{StaticResource SecondaryText}"
                                                   FontSize="10.5" TextWrapping="Wrap" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button Margin="3,0" Padding="15,16" HorizontalContentAlignment="Left"
                                        Command="{Binding NavigateCommand}" CommandParameter="Apps">
                                    <StackPanel>
                                        <TextBlock Text="Приложения" FontWeight="SemiBold" />
                                        <TextBlock Text="Установка и удаление" Style="{StaticResource SecondaryText}"
                                                   FontSize="10.5" TextWrapping="Wrap" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button Margin="7,0,0,0" Padding="15,16" HorizontalContentAlignment="Left"
                                        Command="{Binding NavigateCommand}" CommandParameter="Maintenance">
                                    <StackPanel>
                                        <TextBlock Text="Обслуживание" FontWeight="SemiBold" />
                                        <TextBlock Text="Очистка и восстановление" Style="{StaticResource SecondaryText}"
                                                   FontSize="10.5" TextWrapping="Wrap" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Button>
                            </UniformGrid>
                        </Grid>

                        <!-- Последние события -->
                        <Border Style="{StaticResource DashboardCard}" Margin="0,0,0,8" Padding="18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Недавняя активность" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding EventJournalSummary}" Style="{StaticResource SecondaryText}" Margin="0,5,0,0" />
                                    <TextBlock Text="{Binding DashboardStatus}" Style="{StaticResource SecondaryText}"
                                               FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Button Content="Статистика сети" Click="OnOpenNetworkMonitor" />
                                    <Button Content="Обслуживание" Margin="0,7,0,0"
                                            Command="{Binding NavigateCommand}" CommandParameter="Maintenance" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Страница «Твики» -->
            <Grid Visibility="{Binding IsTweaksPage, Converter={StaticResource BoolToVis}}"
                  IsEnabled="{Binding IsTweakStateReady}"
                  local:Motion.PageTransition="True" Margin="28,24,16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,16,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Оптимизация" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="{Binding PendingText}" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />
                    </StackPanel>
                    <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Button Content="Применить" Style="{StaticResource AccentButton}" Margin="0,0,0,6"
                                Command="{Binding ApplyCommand}" />
                    </WrapPanel>
                </Grid>

                <!-- Простой режим: информативная дуговая шкала с тремя безопасно разделёнными уровнями -->
                <Border Grid.Row="1" Style="{StaticResource DashboardCard}" Margin="0,0,16,14" Padding="16,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Выберите подходящий режим для своего компьютера" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <Grid Width="250" Height="158" Margin="0,2,0,0"
                                  HorizontalAlignment="Left" AutomationProperties.Name="Индикатор уровня оптимизации">
                                <Canvas Width="250" Height="158">
                                    <Path Data="M 18,122 A 107,107 0 0 1 232,122"
                                          Stroke="{DynamicResource TrackOffBrush}" StrokeThickness="14"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    <Path Data="M 18,122 A 107,107 0 0 1 232,122"
                                          Stroke="{DynamicResource BrandGradientBrush}" StrokeThickness="14"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeDashArray="26,26" StrokeDashOffset="26"
                                          local:Motion.ArcProgress="{Binding GaugeProgressValue}">
                                        <Path.Effect>
                                            <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.18" Color="#00B4F4" />
                                        </Path.Effect>
                                    </Path>
                                    <TextBlock Canvas.Left="0" Canvas.Top="136" Text="ЛЁГКАЯ" FontSize="9"
                                               FontWeight="SemiBold" Foreground="{DynamicResource TextDimBrush}" />
                                    <TextBlock Canvas.Left="101" Canvas.Top="136" Text="СРЕДНЯЯ" FontSize="9"
                                               FontWeight="SemiBold" Foreground="{DynamicResource TextDimBrush}" />
                                    <TextBlock Canvas.Left="202" Canvas.Top="136" Text="АГРЕСС." FontSize="9"
                                               FontWeight="SemiBold" Foreground="{DynamicResource TextDimBrush}" />
                                </Canvas>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Margin="0,10,0,24" IsHitTestVisible="False">
                                    <TextBlock Text="{Binding GaugeProgressLabel}" FontSize="30" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding SelectedOptimizationPreset.Title}" FontSize="11"
                                               FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,8,0">
                            <TextBlock Text="Готовый режим" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedOptimizationPreset.Subtitle}"
                                       Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="0,3,0,0" />
                            <TextBlock Text="{Binding SelectedOptimizationPreset.Description}"
                                       TextWrapping="Wrap" LineHeight="19" Margin="0,6,0,0" />
                            <ItemsControl ItemsSource="{Binding OptimizationPresets}" Margin="0,10,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Title}" Margin="0,0,8,6" Padding="14,7"
                                                Command="{Binding DataContext.SelectOptimizationPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Id}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding SelectedOptimizationPreset.Warning}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource WarnBrush}" FontSize="11.5" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding PresetSelectionSummary}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,5,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer Style="{StaticResource OverlayScroll}" local:Motion.SmoothScroll="True" Grid.Row="2"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Expander Style="{StaticResource SectionExpander}" Header="Дополнительные настройки (для опытных)" IsExpanded="False"
                              AutomationProperties.Name="Дополнительные настройки для опытных пользователей">
                        <StackPanel>
                            <TextBlock Text="Обычному пользователю достаточно выбрать один из трёх режимов выше. Здесь собраны дополнительные инструменты для тех, кто хочет точнее настроить Windows."
                                       Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                                       Margin="0,0,16,12" />
                            <Expander Style="{StaticResource SectionExpander}" Header="Профили и восстановление" IsExpanded="False"
                                      Margin="0,0,16,12" AutomationProperties.Name="Дополнительные действия с профилями и восстановлением">
                                <WrapPanel Margin="0,4,0,0">
                                    <Button Content="Импорт профиля" Margin="0,0,8,8"
                                            Command="{Binding LoadProfileCommand}" />
                                    <Button Content="Экспорт профиля" Margin="0,0,8,8"
                                            Command="{Binding SaveProfileCommand}" />
                                    <Button Content="Сбросить выбор" Margin="0,0,8,8"
                                            Command="{Binding ResetSelectionCommand}" />
                                    <Button Content="Создать точку восстановления" Margin="0,0,8,8"
                                            Command="{Binding CreateRestorePointCommand}"
                                            ToolTip="Создать точку восстановления Windows перед ручными изменениями" />
                                </WrapPanel>
                            </Expander>
                            <Expander Style="{StaticResource SectionExpander}" Header="Фильтры категорий" IsExpanded="True"
                                      Margin="0,0,16,12" AutomationProperties.Name="Фильтры категорий сложных твиков">
                                <ItemsControl ItemsSource="{Binding TweakCategories}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding}" Margin="0,0,8,8" Padding="12,6" FontSize="12"
                                                    Command="{Binding DataContext.SetCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                            <ItemsControl ItemsSource="{Binding FilteredTweaks}" Margin="0,0,16,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ContentControl local:Motion.CardEntrance="True">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl" BasedOn="{StaticResource HoverCard}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGroupChild}" Value="True">
                                                    <Setter Property="Margin" Value="28,0,0,0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Стрелка группы -->
                                        <Button Grid.Column="0" Content="{Binding GroupArrow}"
                                                Visibility="{Binding IsGroupHeader, Converter={StaticResource BoolToVis}}"
                                                Margin="0,0,8,0" Padding="6,2" MinWidth="28"
                                                VerticalAlignment="Top" Cursor="Hand"
                                                Background="Transparent" BorderThickness="0"
                                                Foreground="{DynamicResource AccentBrush}"
                                                FontSize="12"
                                                Command="{Binding DataContext.ToggleGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Показать / скрыть отдельные профили" />

                                        <StackPanel Grid.Column="1">
                                            <WrapPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"
                                                           Margin="0,0,8,4" VerticalAlignment="Center" />
                                                <!-- Простой ToolTip=string: так работает общий Style ToolTip из DarkTheme -->
                                                <TextBlock Text="?" FontSize="13" FontWeight="Bold" Width="22" Height="22"
                                                           Margin="0,0,10,4" VerticalAlignment="Center" Cursor="Help"
                                                           TextAlignment="Center" Padding="0,2,0,0"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           Background="Transparent"
                                                           ToolTip="{Binding HelpTip}"
                                                           ToolTipService.Placement="Mouse"
                                                           ToolTipService.InitialShowDelay="200"
                                                           ToolTipService.ShowDuration="60000"
                                                           ToolTipService.BetweenShowDelay="100" />
                                                <Border Style="{StaticResource Badge}" Margin="0,0,8,4">
                                                    <TextBlock Text="{Binding EvidenceLabel}" FontSize="12">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource NeutralBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Evidence}" Value="Measured">
                                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Evidence}" Value="Reasoned">
                                                                        <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                                <Border Style="{StaticResource Badge}" Margin="0,0,8,4"
                                                        Visibility="{Binding RequiresRestorePoint, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="предложит точку восстановления" FontSize="12"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </Border>
                                                <Border Style="{StaticResource Badge}" Margin="0,0,8,4"
                                                        Visibility="{Binding RequiresReboot, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="нужна перезагрузка" FontSize="12"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </Border>
                                                <Border Style="{StaticResource Badge}" Margin="0,0,8,4"
                                                        Visibility="{Binding IsChanged, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="изменено" FontSize="12" Foreground="{DynamicResource AccentBrush}" />
                                                </Border>
                                            </WrapPanel>

                                            <!-- Описание, evidence и предупреждения — только в подсказке «?» (HelpTip) -->
                                            <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" FontSize="12.5" LineHeight="18"
                                                       Margin="0,4,0,0" Foreground="{DynamicResource WarnBrush}"
                                                       Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" FontSize="12.5" LineHeight="18"
                                                       Margin="0,4,0,0" Foreground="{DynamicResource DangerBrush}"
                                                       Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>

                                        <!-- Тумблер: пока карточка выезжает и он проявляется — неактивен (EntranceDone=False) -->
                                        <CheckBox Grid.Column="2"
                                                  VerticalAlignment="Center" Margin="24,0,0,0"
                                                  local:Motion.RevealWithCard="True"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  AutomationProperties.Name="{Binding Title}">
                                            <CheckBox.Style>
                                                <Style TargetType="CheckBox" BasedOn="{StaticResource ToggleSwitch}">
                                                    <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Path=(local:Motion.EntranceDone), RelativeSource={RelativeSource Self}}" Value="False">
                                                            <Setter Property="IsEnabled" Value="False" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </CheckBox.Style>
                                        </CheckBox>
                                    </Grid>
                                </ContentControl>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Expander>
                </ScrollViewer>
            </Grid>

            <!-- Страница «Характеристики ПК» -->
            <Grid Visibility="{Binding IsSystemPage, Converter={StaticResource BoolToVis}}" local:Motion.PageTransition="True" Margin="32,28,16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,16,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Центр производительности" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="Ресурсы Windows, температуры, накопители и активность процессов" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Сохранить TXT" Margin="0,0,8,0" Click="OnSaveReport"
                                ToolTip="Сохранить характеристики в текстовый файл" />
                        <Button Content="Сохранить JSON" Margin="0,0,8,0" Click="OnSaveJsonReport"
                                ToolTip="Экспортировать характеристики в структурированный JSON" />
                        <Button Content="Копировать" Margin="0,0,8,0" Click="OnCopyReport"
                                ToolTip="Скопировать характеристики в буфер обмена текстом" />
                        <Button Content="Обновить" Style="{StaticResource AccentButton}"
                                Command="{Binding RefreshInfoCommand}" />
                    </StackPanel>
                </Grid>

                <ProgressBar Grid.Row="1" IsIndeterminate="True" Margin="0,0,16,12"
                             Visibility="{Binding IsInfoLoading, Converter={StaticResource BoolToVis}}" />

                <ScrollViewer Style="{StaticResource OverlayScroll}" local:Motion.SmoothScroll="True" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,16,8">
                        <TextBlock Text="Не удалось получить сведения. Нажмите «Обновить»." Style="{StaticResource SecondaryText}"
                                   Visibility="{Binding HasNoInfo, Converter={StaticResource BoolToVis}}" />

                        <!-- Компактная сетка: колонки по ширине окна, карточки без провалов (в самую короткую колонку).
                             Правый отступ карточек (12) компенсируем, чтобы край сетки совпал с кнопками сверху -->
                        <ItemsControl ItemsSource="{Binding InfoSections}" Margin="0,0,-12,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <local:MasonryPanel MinColumnWidth="340" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ContentControl Style="{StaticResource HoverCard}" Margin="0,0,12,12" VerticalAlignment="Top">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6" />
                                            <ItemsControl ItemsSource="{Binding Lines}" FontSize="12.5">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,1.5">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="112" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       TextWrapping="Wrap" Margin="0,0,8,0" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ContentControl>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Локальная история Performance Center: последние 60 замеров CPU и RAM -->
                        <Border Style="{StaticResource DashboardCard}" Margin="0,6,0,10" Padding="14,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="История производительности" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding PerformanceHistorySummary}" Style="{StaticResource SecondaryText}"
                                                   FontSize="10.5" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="7" Height="7" CornerRadius="2" Background="{DynamicResource AccentBrush}" Margin="0,0,4,0" />
                                        <TextBlock Text="CPU" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" />
                                        <Border Width="7" Height="7" CornerRadius="2" Background="{DynamicResource BrandGradientBrush}" Margin="0,0,4,0" />
                                        <TextBlock Text="RAM" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" />
                                        <Border Width="7" Height="7" CornerRadius="2" Background="{DynamicResource TextSecondaryBrush}" Margin="0,0,4,0" />
                                        <TextBlock Text="GPU" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" />
                                        <Border Width="7" Height="7" CornerRadius="2" Background="{DynamicResource AccentBrush}" Opacity="0.65" Margin="0,0,4,0" />
                                        <TextBlock Text="Диск" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" />
                                        <Border Width="7" Height="7" CornerRadius="2" Background="{DynamicResource BrandGradientBrush}" Opacity="0.65" Margin="0,0,4,0" />
                                        <TextBlock Text="Сеть" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                              CanContentScroll="True">
                                    <ItemsControl ItemsSource="{Binding PerformanceHistory}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Width="16" Height="52" Margin="1,0" ToolTip="{Binding TooltipText}">
                                                    <Border Background="{DynamicResource TrackOffBrush}" CornerRadius="2" />
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"
                                                                HorizontalAlignment="Center">
                                                        <Border Width="2" Height="{Binding CpuBarHeight}"
                                                                Background="{DynamicResource AccentBrush}" Opacity="{Binding CpuBarOpacity}" CornerRadius="1"
                                                                Margin="0,0,1,0" />
                                                        <Border Width="2" Height="{Binding MemoryBarHeight}"
                                                                Background="{DynamicResource BrandGradientBrush}" CornerRadius="1"
                                                                Margin="0,0,1,0" />
                                                        <Border Width="2" Height="{Binding GpuBarHeight}"
                                                                Background="{DynamicResource TextSecondaryBrush}" Opacity="{Binding GpuBarOpacity}" CornerRadius="1"
                                                                Margin="0,0,1,0" />
                                                        <Border Width="2" Height="{Binding DiskBarHeight}"
                                                                Background="{DynamicResource AccentBrush}" Opacity="{Binding DiskBarOpacity}" CornerRadius="1"
                                                                Margin="0,0,1,0" />
                                                        <Border Width="2" Height="{Binding NetworkBarHeight}"
                                                                Background="{DynamicResource BrandGradientBrush}" Opacity="{Binding NetworkBarOpacity}" CornerRadius="1" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <TextBlock Text="Данные хранятся только в памяти до закрытия приложения."
                                           Style="{StaticResource SecondaryText}" FontSize="10" Margin="0,7,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Процессы: разделы свёрнуты; список обновляется, только пока раздел раскрыт -->
                        <Expander Style="{StaticResource SectionExpander}" Margin="0,6,0,0"
                                  Header="{Binding Processes.ActiveHeader}"
                                  IsExpanded="{Binding Processes.ShowActive, Mode=TwoWay}">
                            <StackPanel>
                                <TextBlock Text="{Binding Processes.ActiveSummary}" Style="{StaticResource SecondaryText}" FontSize="13.5" Margin="2,0,0,12" />
                                <ContentControl Style="{StaticResource HoverCard}" Margin="0">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10" TextElement.FontSize="13" TextElement.Foreground="{DynamicResource TextSecondaryBrush}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="86" />
                                                <ColumnDefinition Width="90" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Процесс" />
                                            <TextBlock Grid.Column="1" Text="Процессор" TextAlignment="Right" />
                                            <TextBlock Grid.Column="2" Text="Память" TextAlignment="Right" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Processes.Active}" FontSize="14.5">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,5">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="86" />
                                                            <ColumnDefinition Width="90" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                                        <TextBlock Grid.Column="1" Text="{Binding CpuText}" TextAlignment="Right" />
                                                        <TextBlock Grid.Column="2" Text="{Binding MemoryText}" TextAlignment="Right" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ContentControl>
                            </StackPanel>
                        </Expander>

                        <Expander Style="{StaticResource SectionExpander}" Margin="0,10,0,0"
                                  Header="{Binding Processes.ExitedHeader}"
                                  IsExpanded="{Binding Processes.ShowExited, Mode=TwoWay}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SecondaryText}" FontSize="12.5" Margin="2,0,0,8"
                                           Text="Процессы, которые закрылись с момента запуска WinOptimizer. Показано, сколько они потребляли в последний замер (память — максимум)." />
                                <TextBlock Style="{StaticResource SecondaryText}" FontSize="12.5" Margin="2,0,0,8"
                                           Text="Пока ни один процесс не завершился.">
                                    <TextBlock.Visibility>
                                        <Binding Path="Processes.Exited.Count">
                                            <Binding.Converter>
                                                <local:CountToVisibilityConverter />
                                            </Binding.Converter>
                                        </Binding>
                                    </TextBlock.Visibility>
                                </TextBlock>
                                <ContentControl Style="{StaticResource HoverCard}" Margin="0">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6" TextElement.FontSize="12" TextElement.Foreground="{DynamicResource TextSecondaryBrush}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="92" />
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="78" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Процесс" />
                                            <TextBlock Grid.Column="1" Text="Закрыт" TextAlignment="Right" />
                                            <TextBlock Grid.Column="2" Text="Работал" TextAlignment="Right" />
                                            <TextBlock Grid.Column="3" Text="Процессор" TextAlignment="Right" />
                                            <TextBlock Grid.Column="4" Text="Память" TextAlignment="Right" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Processes.Exited}" FontSize="12.5">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,1.5">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="64" />
                                                            <ColumnDefinition Width="92" />
                                                            <ColumnDefinition Width="70" />
                                                            <ColumnDefinition Width="78" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                                        <TextBlock Grid.Column="1" Text="{Binding ExitedAtText}" TextAlignment="Right" />
                                                        <TextBlock Grid.Column="2" Text="{Binding RunTimeText}" TextAlignment="Right" />
                                                        <TextBlock Grid.Column="3" Text="{Binding CpuText}" TextAlignment="Right" />
                                                        <TextBlock Grid.Column="4" Text="{Binding MemoryText}" TextAlignment="Right" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ContentControl>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ============ MS Store ============ -->
            <Grid Visibility="{Binding IsStorePage, Converter={StaticResource BoolToVis}}" local:Motion.PageTransition="True" Margin="32,28,16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Margin="0,0,16,8">
                    <StackPanel>
                        <TextBlock Text="Microsoft Store" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource SecondaryText}" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="Каталог и установка прямо в WinOptimizer (через winget). Официальный Store не открывается." />
                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="Установка" Margin="0,0,8,0"
                                    Visibility="{Binding Settings.ShowAppsTab, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding NavigateCommand}" CommandParameter="Apps"/>
                            <Button Content="Удаление" Margin="0,0,8,0"
                                    Visibility="{Binding Settings.ShowDebloatTab, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding NavigateCommand}" CommandParameter="Debloat"/>
                            <Button Content="Microsoft Store" Style="{StaticResource AccentButton}"
                                    Command="{Binding NavigateCommand}" CommandParameter="Store"/>
                        </WrapPanel>
                    </StackPanel>
                </DockPanel>

                <Border Grid.Row="1" Style="{StaticResource BorderCard}" Margin="0,0,16,14" Padding="16,14">
                    <StackPanel>
                        <!-- Поле поиска в стиле чата: одна скруглённая плашка, кнопка отправки внутри -->
                        <Border CornerRadius="22" Padding="20,8,8,8" BorderThickness="1"
                                Background="{DynamicResource BgSidebarBrush}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                    <Style.Triggers>
                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="StoreSearchBox" Text="{Binding Store.Query, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent" BorderThickness="0" Padding="0" FontSize="15"
                                         VerticalContentAlignment="Center" MinHeight="36"
                                         AutomationProperties.Name="Поиск в Microsoft Store">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding Store.SearchCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                                <TextBlock Text="Найти приложение в Microsoft Store…" FontSize="15" IsHitTestVisible="False"
                                           VerticalAlignment="Center" Foreground="{DynamicResource TextDimBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=StoreSearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button Grid.Column="1" Width="36" Height="36" Margin="10,0,0,0" Cursor="Hand"
                                        Command="{Binding Store.SearchCommand}" ToolTip="Найти (Enter)"
                                        AutomationProperties.Name="Найти">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Dot" CornerRadius="18" Background="{DynamicResource AccentBrush}">
                                                <TextBlock Text="↑" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource BgWindowBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Dot" Property="Background" Value="{DynamicResource AccentStrongBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.4" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>
                        <DockPanel Margin="6,12,0,0">
                            <Button DockPanel.Dock="Right" Content="★ Избранные" Padding="10,5" FontSize="12"
                                    Command="{Binding Store.RefreshFeaturedCommand}" />
                            <TextBlock Text="{Binding Store.StatusText}" TextWrapping="Wrap" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentBrush}" FontSize="12.5" />
                        </DockPanel>
                        <!-- Проверка winget -->
                        <DockPanel Margin="0,10,0,0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Проверить winget" Padding="12,7" Margin="10,0,0,0"
                                        Command="{Binding Store.CheckWingetCommand}" />
                                <Button Content="Установить / починить winget" Padding="12,7" Margin="8,0,0,0"
                                        Command="{Binding Store.RepairWingetCommand}" />
                            </StackPanel>
                            <TextBlock Text="{Binding Store.WingetStatus}" TextWrapping="Wrap" VerticalAlignment="Center"
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <ScrollViewer Style="{StaticResource OverlayScroll}" local:Motion.SmoothScroll="True" Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,16,0" Padding="0,0,0,8">
                    <!-- Правый отступ карточек (12) компенсируем: правый край сетки совпадает с краем плашки поиска -->
                    <ItemsControl ItemsSource="{Binding Store.Results}" Margin="0,0,-12,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel ItemWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={StaticResource CardWidth}}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,12,12" Cursor="Hand"
                                        Style="{StaticResource BorderCard}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Border Width="44" Height="44" CornerRadius="10" Background="{DynamicResource BgCardHoverBrush}"
                                                    Margin="0,0,12,0" ClipToBounds="True">
                                                <Grid>
                                                    <TextBlock Text="{Binding Initial}" FontSize="20" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <Image Source="{Binding Icon}" Stretch="Uniform" Margin="2"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}" />
                                                </Grid>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="190" />
                                                <TextBlock Text="{Binding Publisher}" FontSize="11.5"
                                                           Foreground="{DynamicResource TextDimBrush}"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="190" />
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Grid.Row="1" Text="{Binding Description}" TextWrapping="Wrap"
                                                   Style="{StaticResource SecondaryText}" FontSize="12.5"
                                                   MaxHeight="48" TextTrimming="CharacterEllipsis" Margin="0,0,0,12" />
                                        <DockPanel Grid.Row="2">
                                            <TextBlock DockPanel.Dock="Left" FontSize="10.5" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextDimBrush}"
                                                       Text="{Binding Id, StringFormat=Id: {0}}"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="120" />
                                            <Button DockPanel.Dock="Right" Content="Установить"
                                                    Style="{StaticResource AccentButton}" Padding="12,7"
                                                    HorizontalAlignment="Right"
                                                    Command="{Binding DataContext.Store.InstallCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </DockPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>


            <!-- ============ Игровой центр ============ -->
            <Grid Visibility="{Binding IsGamesPage, Converter={StaticResource BoolToVis}}"
                  local:Motion.PageTransition="True" Margin="28,22,18,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Заголовок и сканирование -->
                <Grid Margin="0,0,12,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Игровой центр" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="{Binding Games.GameCountText}" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />
                        <TextBlock Text="Профили игр, производительность GPU, подбор настроек и игровые инструменты."
                                   Style="{StaticResource SecondaryText}" FontSize="11" Margin="0,3,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Найти игры" Style="{StaticResource AccentButton}"
                            VerticalAlignment="Center" Padding="16,10" Command="{Binding Games.ScanCommand}" />
                </Grid>

                <!-- Состояние Game Boost и быстрые настройки -->
                <Border Grid.Row="1" Style="{StaticResource BorderCard}" Margin="0,0,12,14" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="GAME BOOST" FontSize="10.5" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Text="Автоматическая оптимизация во время игры"
                                           FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding Games.GameBoostStatus}" Margin="0,5,0,0"
                                           FontSize="12.5" FontWeight="Medium" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Games.ConfiguredGameCount, StringFormat='Включено игровых профилей: {0}'}"
                                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding Games.ActiveGameCount, StringFormat='Сейчас оптимизируются игры: {0}'}"
                                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="{DynamicResource BgCardHoverBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="12" Padding="13" VerticalAlignment="Center">
                                <StackPanel MinWidth="135">
                                    <TextBlock Text="СОСТОЯНИЕ" FontSize="9.5" FontWeight="Bold"
                                               Foreground="{DynamicResource TextDimBrush}" />
                                    <TextBlock Text="{Binding Games.GameBoostRunning, StringFormat='Служба запущена: {0}'}"
                                               FontSize="12" FontWeight="SemiBold" Margin="0,5,0,0" />
                                    <TextBlock Text="{Binding Games.GameBoostActive, StringFormat='Игровой режим активен: {0}'}"
                                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,13,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Служба применяет настройки только к выбранным играм и возвращает исходные значения после выхода. Defender, брандмауэр и UAC остаются включены."
                                       Style="{StaticResource SecondaryText}" FontSize="10.5"
                                       TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                                <Button Content="Установить / запустить"
                                        Style="{StaticResource AccentButton}" Margin="0,0,6,0"
                                        Visibility="{Binding Games.GameBoostNeedsInstall, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding Games.InstallGameBoostServiceCommand}" />
                                <Button Content="Обновить службу" Margin="0,0,6,0"
                                        Visibility="{Binding Games.GameBoostRunning, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding Games.InstallGameBoostServiceCommand}" />
                                <Button Content="Удалить" Margin="0,0,6,0"
                                        Visibility="{Binding Games.GameBoostInstalled, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding Games.RemoveGameBoostServiceCommand}" />
                                <Button Content="Проверить" Command="{Binding Games.RefreshGameBoostStatusCommand}" />
                            </WrapPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Инструменты и фильтры -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource BorderCard}" Margin="0,0,12,12" Padding="12">
                        <StackPanel>
                        <WrapPanel VerticalAlignment="Center">
                            <Button Content="Определить железо" Margin="0,0,8,0"
                                    ToolTip="Определить процессор, видеокарту и экран и сравнить их с тестами комплектующих"
                                    Command="{Binding Games.DetectHardwareCommand}" />
                            <Button Content="Скачать OptiScaler" Margin="0,0,8,0"
                                    Command="{Binding Games.DownloadOptiCommand}" />
                            <ComboBox Width="190" Margin="0,0,8,0" VerticalContentAlignment="Center"
                                      ItemsSource="{Binding Games.TargetFpsLabels}"
                                      SelectedIndex="{Binding Games.TargetFpsIndex, Mode=TwoWay}"
                                      ToolTip="Целевой FPS, под который подбираются настройки"
                                      AutomationProperties.Name="Целевой FPS" />
                            <TextBox Width="250" Tag="Поиск игры или платформы…"
                                     Text="{Binding Games.Filter, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Фильтр по названию игры или платформе" />
                        </WrapPanel>
                        <TextBlock Text="{Binding Games.HardwareSummary}" TextWrapping="Wrap" FontSize="11.5"
                                   Margin="0,9,0,0" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Visibility="{Binding Games.HasHardware, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" Style="{StaticResource OverlayScroll}"
                                  local:Motion.SmoothScroll="True" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,8">
                        <StackPanel>
                            <Border Background="{DynamicResource BgCardHoverBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="14" Padding="20" Margin="0,0,12,12">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Games.HasGames}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="Здесь появятся ваши игры" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="Нажмите «Найти игры», чтобы просканировать библиотеки Steam, Epic, GOG, Xbox и стандартные игровые папки."
                                               Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,5,0,12" />
                                    <Button Content="Сканировать библиотеки" Style="{StaticResource AccentButton}"
                                            HorizontalAlignment="Left" Command="{Binding Games.ScanCommand}" />
                                </StackPanel>
                            </Border>

                            <ItemsControl ItemsSource="{Binding Games.FilteredGames}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource BorderCard}" Margin="0,0,12,12" Padding="16">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <Border Style="{StaticResource Badge}" Margin="10,0,0,0"
                                                                Background="{DynamicResource BgCardHoverBrush}">
                                                            <TextBlock Text="{Binding Platform}" FontSize="10.5" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding OptiStatus}" Margin="0,5,0,0" FontSize="11.5"
                                                               Foreground="{DynamicResource AccentBrush}" />
                                                    <TextBlock Text="{Binding Path}" Margin="0,3,0,0" FontSize="10.5"
                                                               Foreground="{DynamicResource TextDimBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <WrapPanel Grid.Column="1" VerticalAlignment="Center"
                                                           HorizontalAlignment="Right">
                                                    <Button Content="{Binding AdviceButtonText}" Margin="0,0,6,6" Padding="11,7"
                                                            ToolTip="Подобрать настройки графики под ваше железо"
                                                            Command="{Binding DataContext.Games.OptimizeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="GPU: макс." Margin="0,0,6,6" Padding="10,7"
                                                            ToolTip="Выбрать режим высокой производительности GPU в Windows"
                                                            Command="{Binding DataContext.Games.ToggleGpuCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="Папка" Margin="0,0,6,6" Padding="10,7"
                                                            Command="{Binding DataContext.Games.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="Убрать Opti" Margin="0,0,6,6" Padding="10,7"
                                                            Visibility="{Binding OptiInstalled, Converter={StaticResource BoolToVis}}"
                                                            Command="{Binding DataContext.Games.RemoveOptiCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="Поставить OptiScaler" Style="{StaticResource AccentButton}"
                                                            Margin="0,0,0,6" Padding="12,7"
                                                            Command="{Binding DataContext.Games.InstallOptiCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                </WrapPanel>

                                                <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0"
                                                        Padding="11,10" CornerRadius="10"
                                                        Background="{DynamicResource BgCardHoverBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="260" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                                                            <CheckBox Content="Включить Game Boost для этой игры"
                                                                      IsChecked="{Binding GameBoostEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      FontSize="12.5" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding GameBoostModeDescription}" Margin="0,4,12,0"
                                                                       FontSize="10.5" TextWrapping="Wrap"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        </StackPanel>
                                                        <ComboBox Grid.Row="0" Grid.Column="1" MinHeight="34"
                                                                  VerticalContentAlignment="Center"
                                                                  ItemsSource="{Binding DataContext.Games.GameBoostModeOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  DisplayMemberPath="Label" SelectedValuePath="Id"
                                                                  SelectedValue="{Binding GameBoostMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  IsEnabled="{Binding GameBoostEnabled}"
                                                                  ToolTip="Выбери приоритет процесса для этой игры" />

                                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,10,12,0" VerticalAlignment="Center">
                                                            <TextBlock Text="План питания Windows" FontSize="11.5" FontWeight="SemiBold" />
                                                            <TextBlock Text="При нескольких запущенных играх действует выбор последней запущенной; после выхода план возвращается."
                                                                       FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        </StackPanel>
                                                        <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" MinHeight="34"
                                                                  VerticalContentAlignment="Center"
                                                                  ItemsSource="{Binding DataContext.Games.GameBoostPowerPlanOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  DisplayMemberPath="Label" SelectedValuePath="Id"
                                                                  SelectedValue="{Binding GameBoostPowerPlanId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  IsEnabled="{Binding GameBoostEnabled}"
                                                                  ToolTip="Выбери план питания Windows для этой игры" />
                                                    </Grid>
                                                </Border>

                                                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,12,0,0"
                                                            Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                                                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,10" />
                                                    <TextBlock Text="{Binding Result.Headline}" FontSize="13.5" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding WarningsText}" Margin="0,6,0,0" FontSize="12"
                                                               TextWrapping="Wrap" Foreground="{DynamicResource WarnBrush}"
                                                               Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}" />
                                                    <ItemsControl ItemsSource="{Binding Result.Settings}" Margin="0,8,0,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,0,0,7">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="190" />
                                                                        <ColumnDefinition Width="190" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontSize="11.5"
                                                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,9,0" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" FontSize="11.5"
                                                                               FontWeight="SemiBold" Margin="0,0,9,0" />
                                                                    <TextBlock Grid.Column="2" Text="{Binding Reason}" TextWrapping="Wrap" FontSize="11"
                                                                               Foreground="{DynamicResource TextDimBrush}" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Text="{Binding NotesText}" Margin="0,6,0,0" FontSize="10.5"
                                                               TextWrapping="Wrap" Foreground="{DynamicResource TextDimBrush}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- Вторая половина страниц: обслуживание, debloat, приложения, настройки -->
            <local:MainWindowPages Grid.Row="0" DataContext="{Binding}" />


            <!-- Строка состояния -->
            <Border Grid.Row="1" Background="{DynamicResource BgSidebarBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="32,0,24,0" MinHeight="40">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar IsIndeterminate="True" VerticalAlignment="Top"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Grid.ColumnSpan="2" />
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="1" Text="Требуется перезагрузка, чтобы изменения вступили в силу"
                               VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{DynamicResource WarnBrush}"
                               Visibility="{Binding RebootRequired, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Window>
