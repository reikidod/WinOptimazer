<Window x:Class="WinOptimizer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WinOptimizer.Views"
        Title="WinOptimizer"
        Width="1240" Height="820" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{DynamicResource BgWindowBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="14"
        UseLayoutRounding="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:CardWidthConverter x:Key="CardWidth" />
    </Window.Resources>
    <Grid x:Name="RootGrid" ClipToBounds="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid Grid.ColumnSpan="2" ClipToBounds="True" IsHitTestVisible="False">
            <Image x:Name="BackgroundImage" Stretch="UniformToFill" Visibility="Collapsed"
                   RenderOptions.BitmapScalingMode="HighQuality">
                <Image.Effect>
                    <BlurEffect x:Name="BackgroundBlur" Radius="0" KernelType="Gaussian" RenderingBias="Performance" />
                </Image.Effect>
                <Image.CacheMode>
                    <BitmapCache EnableClearType="False" RenderAtScale="1" />
                </Image.CacheMode>
            </Image>
            <Rectangle x:Name="BackgroundDim" Fill="{DynamicResource BgWindowBrush}"
                       Opacity="0" Visibility="Collapsed" />
        </Grid>
        <Border Background="{DynamicResource BgSidebarBrush}" Panel.ZIndex="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="0" Opacity="0.5" Color="Black" />
            </Border.Effect>
            <Grid Margin="16,24,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Margin="6,0,0,28">
                    <TextBlock Text="WinOptimizer" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Оптимизация Windows 10/11" Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Row="1">
                    <RadioButton Style="{StaticResource NavButton}" GroupName="Pages"
                                 IsChecked="{Binding IsHomePage, Mode=TwoWay}"
                                 AutomationProperties.Name="Страница «Главная»">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Data="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Главная" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="Pages"
                                 IsChecked="{Binding IsTweaksPage, Mode=TwoWay}"
                                 Visibility="{Binding Settings.ShowTweaksTab, Converter={StaticResource BoolToVis}}"
                                 AutomationProperties.Name="Страница «Твики»">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Data="M13 3L4 14h7l-1 7 9-11h-7l1-7z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Оптимизация системы" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="Pages"
                                 IsChecked="{Binding IsSystemPage, Mode=TwoWay}"
                                 Visibility="{Binding Settings.ShowSystemTab, Converter={StaticResource BoolToVis}}"
                                 AutomationProperties.Name="Страница «Система»">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Data="M4 6h16v2H4zm0 5h16v2H4zm0 5h10v2H4z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Мой ПК" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="Pages"
                                 IsChecked="{Binding IsGamesPage, Mode=TwoWay}"
                                 Visibility="{Binding Settings.ShowGamesTab, Converter={StaticResource BoolToVis}}"
                                 AutomationProperties.Name="Страница «Игры»">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Data="M21 6H3c-1.1 0-2 .9-2 2v8c0 1.1.9 2 2 2h18c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-10 7H8v3H6v-3H3v-2h3V8h2v3h3v2zm4.5 2c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm4-3c-.83 0-1.5-.67-1.5-1.5S18.67 9 19.5 9s1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Игры" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="Pages"
                                 IsChecked="{Binding IsMaintenancePage, Mode=TwoWay}"
                                 Visibility="{Binding Settings.ShowMaintenanceTab, Converter={StaticResource BoolToVis}}"
                                 AutomationProperties.Name="Страница «Обслуживание»">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Data="M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Обслуживание" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="Pages"
                                 IsChecked="{Binding IsDebloatPage, Mode=TwoWay}"
                                 Visibility="{Binding Settings.ShowDebloatTab, Converter={StaticResource BoolToVis}}"
                                 AutomationProperties.Name="Страница «Debloat»">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Удаление приложений" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="Pages"
                                 IsChecked="{Binding IsAppsPage, Mode=TwoWay}"
                                 Visibility="{Binding Settings.ShowAppsTab, Converter={StaticResource BoolToVis}}"
                                 AutomationProperties.Name="Страница «Приложения»">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Data="M4 8h4V4H4v4zm6 12h4v-4h-4v4zm-6 0h4v-4H4v4zm0-6h4v-4H4v4zm6 0h4v-4h-4v4zm6-10v4h4V4h-4zm-6 4h4V4h-4v4zm6 6h4v-4h-4v4zm0 6h4v-4h-4v4z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Приложения" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="Pages"
                                 IsChecked="{Binding IsStorePage, Mode=TwoWay}"
                                 Visibility="{Binding Settings.ShowStoreTab, Converter={StaticResource BoolToVis}}"
                                 AutomationProperties.Name="Страница «Магазин»">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Data="M18 6h-2c0-2.21-1.79-4-4-4S8 3.79 8 6H6c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-6-2c1.1 0 2 .9 2 2h-4c0-1.1.9-2 2-2zm6 16H6V8h2v2c0 .55.45 1 1 1s1-.45 1-1V8h4v2c0 .55.45 1 1 1s1-.45 1-1V8h2v12z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Магазин твиков" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="Pages"
                                 IsChecked="{Binding IsSettingsPage, Mode=TwoWay}"
                                 AutomationProperties.Name="Страница «Настройки»">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Data="M19.14 12.94c.04-.31.06-.63.06-.94 0-.31-.02-.63-.06-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.04.31-.06.63-.06.94s.02.63.06.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Настройки" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
                <StackPanel Grid.Row="2" Margin="0,16,0,0">
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource SecondaryText}" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="1">
            <local:DashboardPage Visibility="{Binding IsHomePage, Converter={StaticResource BoolToVis}}"
                                 local:Motion.PageTransition="True" />
            <local:TweaksPage Visibility="{Binding IsTweaksPage, Converter={StaticResource BoolToVis}}" />
            <local:SystemInfoPage Visibility="{Binding IsSystemPage, Converter={StaticResource BoolToVis}}" />
            <local:GamesPage Visibility="{Binding IsGamesPage, Converter={StaticResource BoolToVis}}" />
            <local:StorePage Visibility="{Binding IsStorePage, Converter={StaticResource BoolToVis}}" />
            <local:MainWindowPages />
        </Grid>
    </Grid>
</Window>
