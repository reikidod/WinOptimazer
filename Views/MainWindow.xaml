<Window x:Class="WinOptimizer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WinOptimizer.Views"
        Title="WinOptimizer"
        Width="1120" Height="780" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{StaticResource BgWindowBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="14"
        UseLayoutRounding="True">
    <Grid>
        <TextBlock Text="Restoring..." HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
</Window>
