<Window x:Class="WinOptimizer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WinOptimizer.Views"
        Title="WinOptimizer"
        Width="1180" Height="800" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{DynamicResource BgWindowBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="14"
        UseLayoutRounding="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:CardWidthConverter x:Key="CardWidth" />

        <Style x:Key="BorderCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BgCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BgCardHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Заголовок страницы и подзаголовок -->
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="SecondaryText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- Небольшой «бейдж» с текстом -->
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="#33FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" ClipToBounds="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Пользовательский фон: картинка с размытием и затемняющий слой цвета темы (под всеми страницами) -->
        <!-- Клип, чтобы blur не «зумил» картинку: изображение чуть увеличено под радиус, края обрезаны -->
        <Grid Grid.ColumnSpan="2" ClipToBounds="True" IsHitTestVisible="False">
            <Image x:Name="BackgroundImage" Stretch="UniformToFill" Visibility="Collapsed"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <ScaleTransform x:Name="BackgroundScale" ScaleX="1" ScaleY="1" />
                </Image.RenderTransform>
                <Image.Effect>
                    <BlurEffect x:Name="BackgroundBlur" Radius="0" KernelType="Gaussian" RenderingBias="Performance" />
                </Image.Effect>
                <Image.CacheMode>
                    <BitmapCache EnableClearType="False" RenderAtScale="1" />
                </Image.CacheMode>
            </Image>
            <Rectangle x:Name="BackgroundDim" Fill="{DynamicResource BgWindowBrush}"
                       Opacity="0" Visibility="Collapsed" />
        </Grid>

        <!-- SIDEBAR_AND_PAGES_PLACEHOLDER_SEE_FULL_FILE -->
    </Grid>
</Window>
