<Window x:Class="WinOptimizer.Views.DiagnosticProfileEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Профиль Input Latency" Width="760" Height="620"
        MinWidth="560" MinHeight="420" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgWindowBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Cascadia Mono, Cascadia Code, Consolas">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Профиль устройств и твиков" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <TextBox x:Name="ProfileText" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True"
                 TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontFamily="Cascadia Mono, Consolas" FontSize="12" Padding="10"
                 Background="{DynamicResource BgCardBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                 BorderBrush="{DynamicResource BorderBrush}"/>
        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Восстановить копию" MinWidth="150" Margin="0,0,8,0" Click="RestoreBackup_Click"/>
                <Button Content="Отмена" MinWidth="90" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button Content="Сохранить" MinWidth="110" Click="Save_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
