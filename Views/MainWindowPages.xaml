<UserControl x:Class="WinOptimizer.Views.MainWindowPages"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WinOptimizer.Views"
             xmlns:settings="clr-namespace:WinOptimizer.Views;assembly=WinOptimizer.Settings">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
<Grid>
            <Grid Visibility="{Binding IsMaintenancePage, Converter={StaticResource BoolToVis}}" local:Motion.PageTransition="True" Margin="28,24,16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Margin="0,0,16,18">
                    <TextBlock Text="Обслуживание" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Временные файлы, автозагрузка и откат системы" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />
                </StackPanel>

                <ScrollViewer Style="{StaticResource OverlayScroll}" local:Motion.SmoothScroll="True" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,16,8" DataContext="{Binding Maintenance}">
                        <ProgressBar IsIndeterminate="True" Margin="0,0,0,12"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

                        <!-- Временные файлы -->
                        <ContentControl Style="{StaticResource HoverCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Временные файлы" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource SecondaryText}" Margin="0,6,0,0" LineHeight="21"
                                               Text="Старые файлы из папок Temp пользователя и Windows. Файлы младше суток и те, что сейчас используются, не трогаются." />
                                    <TextBlock Text="{Binding CleanupSummary}" Margin="0,8,0,0" Foreground="{DynamicResource AccentBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                                    <Button Content="Проверить" Margin="0,0,8,0" Command="{Binding ScanCommand}" />
                                    <Button Content="Очистить" Style="{StaticResource AccentButton}" Command="{Binding CleanCommand}" />
                                </StackPanel>
                            </Grid>
                        </ContentControl>

                        <!-- Восстановление системы -->
                        <ContentControl Style="{StaticResource HoverCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Откат системы" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource SecondaryText}" Margin="0,6,0,0" LineHeight="21"
                                               Text="Перед системными изменениями приложение предлагает создать точку восстановления. Здесь можно открыть окно «Восстановление системы» и вернуть Windows к одной из точек." />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Открыть" VerticalAlignment="Center" Margin="24,0,0,0"
                                        Command="{Binding OpenRestoreCommand}" />
                            </Grid>
                        </ContentControl>

                        <!-- Автозагрузка -->
                        <ContentControl Style="{StaticResource HoverCard}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Автозагрузка" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource SecondaryText}" Margin="0,6,0,0" LineHeight="21"
                                                   Text="Программы из ключей Run реестра. Отключение обратимо: запись не удаляется, программа просто не запускается при входе (так же работает диспетчер задач). Папка «Автозагрузка» и планировщик заданий здесь не показываются." />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Обновить" VerticalAlignment="Top" Margin="24,0,0,0"
                                            Command="{Binding RefreshStartupCommand}" />
                                </Grid>

                                <TextBlock Text="{Binding StartupError}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,12,0,0"
                                           Visibility="{Binding HasStartupError, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="В автозагрузке реестра ничего не найдено." Style="{StaticResource SecondaryText}" Margin="0,12,0,0"
                                           Visibility="{Binding HasNoStartupItems, Converter={StaticResource BoolToVis}}" />

                                <ItemsControl ItemsSource="{Binding StartupItems}" Margin="0,12,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="8" Padding="12,10" Margin="0,0,0,4">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#22FFFFFF" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <WrapPanel>
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,10,2" />
                                                            <Border Style="{StaticResource Badge}" Margin="0,0,0,2">
                                                                <TextBlock Text="{Binding ScopeTitle}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            </Border>
                                                        </WrapPanel>
                                                        <TextBlock Text="{Binding Command}" ToolTip="{Binding Command}" FontSize="12.5"
                                                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextDimBrush}" />
                                                        <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" FontSize="12.5" Margin="0,4,0,0"
                                                                   Foreground="{DynamicResource DangerBrush}"
                                                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Margin="20,0,0,0"
                                                              IsChecked="{Binding IsEnabled, Mode=OneWay}" Command="{Binding ToggleCommand}"
                                                              AutomationProperties.Name="{Binding Name}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ContentControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>


            <!-- Страница «Лишние приложения» -->
            <Grid Visibility="{Binding IsDebloatPage, Converter={StaticResource BoolToVis}}" local:Motion.PageTransition="True" Margin="32,28,16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,16,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Удаление приложений" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="Все установленные программы и приложения Windows. Удаляйте штатным деинсталлятором и сразу стирайте остатки: папки, ярлыки, записи реестра — как в Geek Uninstaller. Если программа не удаляется, её можно снести принудительно."
                                   Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding Debloat.StatusText}" Style="{StaticResource SecondaryText}" Margin="0,6,0,0"
                                   Foreground="{DynamicResource AccentBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Обновить" Margin="0,0,8,0" Command="{Binding Debloat.RefreshCommand}" />
                        <Button Content="Рекомендуемые" Margin="0,0,8,0" Command="{Binding Debloat.SelectRecommendedCommand}" />
                        <Button Content="Удалить выбранные" Style="{StaticResource AccentButton}"
                                Command="{Binding Debloat.RemoveSelectedCommand}" />
                    </StackPanel>
                </Grid>
                <!-- Поиск и фильтр по типу -->
                <Grid Grid.Row="1" Margin="0,0,16,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding Debloat.SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Поиск по названию и издателю…"
                             ToolTip="Поиск по названию и издателю" Margin="0,0,12,0"
                             AutomationProperties.Name="Поиск приложений" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <StackPanel.Resources>
                            <Style x:Key="FilterChip" TargetType="RadioButton">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Margin" Value="0,0,8,0" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="Chip" CornerRadius="8" Padding="12,8"
                                                    Background="{DynamicResource BgCardBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource BgCardHoverBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Chip" Property="Background" Value="#243044" />
                                                    <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </StackPanel.Resources>
                        <RadioButton GroupName="DebloatFilter" Style="{StaticResource FilterChip}"
                                     Content="{Binding Debloat.AllLabel}"
                                     IsChecked="{Binding Debloat.IsFilterAll, Mode=OneWay}"
                                     Command="{Binding Debloat.SetFilterCommand}" CommandParameter="0" />
                        <RadioButton GroupName="DebloatFilter" Style="{StaticResource FilterChip}"
                                     Content="{Binding Debloat.GamesLabel}"
                                     IsChecked="{Binding Debloat.IsFilterGames, Mode=OneWay}"
                                     Command="{Binding Debloat.SetFilterCommand}" CommandParameter="1" />
                        <RadioButton GroupName="DebloatFilter" Style="{StaticResource FilterChip}"
                                     Content="{Binding Debloat.ProgramsLabel}"
                                     IsChecked="{Binding Debloat.IsFilterPrograms, Mode=OneWay}"
                                     Command="{Binding Debloat.SetFilterCommand}" CommandParameter="2" />
                        <RadioButton GroupName="DebloatFilter" Style="{StaticResource FilterChip}" Margin="0"
                                     Content="{Binding Debloat.WindowsLabel}"
                                     IsChecked="{Binding Debloat.IsFilterWindows, Mode=OneWay}"
                                     Command="{Binding Debloat.SetFilterCommand}" CommandParameter="3" />
                    </StackPanel>
                </Grid>
                <ScrollViewer Style="{StaticResource OverlayScroll}" local:Motion.SmoothScroll="True" Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Debloat.View}" Margin="0,0,16,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Вся плашка кликабельна: переключает выбор -->
                                <ToggleButton IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              Foreground="{DynamicResource TextPrimaryBrush}"
                                              HorizontalContentAlignment="Stretch"
                                              Cursor="Hand" Margin="0,0,0,0"
                                              Background="Transparent" BorderThickness="0" Padding="0">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Card" Background="{DynamicResource BgCardBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                    CornerRadius="12" Padding="16,14" Margin="0,0,14,12"
                                                    SnapsToDevicePixels="True">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.35" Color="Black" />
                                                </Border.Effect>
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource BgCardHoverBrush}" />
                                                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                    <Setter TargetName="Card" Property="Background" Value="#243044" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="22" Height="22" CornerRadius="6" Margin="0,0,14,0"
                                                VerticalAlignment="Center"
                                                BorderThickness="1.5" BorderBrush="{DynamicResource BorderHoverBrush}"
                                                Background="Transparent">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="✓" FontSize="12" FontWeight="Bold" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <Border Grid.Column="1" Width="44" Height="44" CornerRadius="12"
                                                Background="#22FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1"
                                                Margin="0,0,14,0" VerticalAlignment="Center" ClipToBounds="True">
                                            <Grid>
                                                <TextBlock Text="▦" FontSize="16" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" Opacity="0.35"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <Image Source="{Binding Icon}" Stretch="Uniform" Margin="2"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}" />
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource SecondaryText}" Margin="0,3,0,0" />
                                            <TextBlock Text="{Binding Status}" FontSize="12" Margin="0,4,0,0"
                                                       Foreground="{DynamicResource AccentBrush}" />
                                        </StackPanel>

                                        <Button Grid.Column="3" Content="Удалить" VerticalAlignment="Center" Margin="12,0,0,0"
                                                Command="{Binding DataContext.Debloat.RemoveOneCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Удалить и сразу найти остатки" />
                                    </Grid>
                                </ToggleButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- Страница «Приложения» -->
            <Grid Visibility="{Binding IsAppsPage, Converter={StaticResource BoolToVis}}" local:Motion.PageTransition="True" Margin="32,28,16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,16,18">
                    <TextBlock Text="Приложения и Zapret" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Установка популярных программ и Zapret (Flowseal) как службы"
                               Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding Apps.StatusText}" Style="{StaticResource SecondaryText}" Margin="0,6,0,0"
                               Foreground="{DynamicResource AccentBrush}" />
                </StackPanel>
                <ScrollViewer Style="{StaticResource OverlayScroll}" local:Motion.SmoothScroll="True" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,16,8">
                        <TextBlock Text="Рекомендуемые файлы" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Text="Библиотеки и утилиты для тонкой настройки. Файл скачивается по кнопке и проверяется по контрольной сумме перед запуском."
                                   Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,12" />
                        <ItemsControl ItemsSource="{Binding Apps.Recommended.Groups}" Margin="0,0,0,10">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,10">
                                        <!-- Заголовок группы (как у групп твиков) -->
                                        <Border Background="{DynamicResource BgCardBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="10"
                                                Padding="12,10" Cursor="Hand"
                                                Margin="0,0,0,6">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                              Command="{Binding DataContext.Apps.Recommended.ToggleGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              CommandParameter="{Binding}" />
                                            </Border.InputBindings>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Arrow}" FontSize="12"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           VerticalAlignment="Center" Margin="0,0,10,0"
                                                           MinWidth="16" />
                                                <TextBlock Grid.Column="1" Text="{Binding Title}"
                                                           FontSize="14" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding Count, StringFormat={}{0}}"
                                                           FontSize="12" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextDimBrush}"
                                                           Margin="12,0,0,0" />
                                            </Grid>
                                        </Border>
                                        <!-- Содержимое группы -->
                                        <ItemsControl ItemsSource="{Binding Items}"
                                                      Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <ContentControl Style="{StaticResource HoverCard}" Margin="0,0,0,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                                <TextBlock Text="{Binding Description}" Style="{StaticResource SecondaryText}"
                                                                           TextWrapping="Wrap" Margin="0,3,0,0" FontSize="12.5" />
                                                                <TextBlock Text="{Binding Note}" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"
                                                                           Foreground="{DynamicResource TextDimBrush}" />
                                                                <TextBlock Text="{Binding Status}" FontSize="11.5" Margin="0,4,0,0"
                                                                           Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" />
                                                                <StackPanel Margin="0,8,0,0"
                                                                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                                                                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" Height="5" />
                                                                    <TextBlock Text="{Binding ProgressText}" FontSize="11" Margin="0,3,0,0"
                                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Content="{Binding File.ButtonText}" Style="{StaticResource AccentButton}"
                                                                    VerticalAlignment="Center" Margin="14,0,0,0" MinWidth="110" Padding="12,8"
                                                                    Command="{Binding DataContext.Apps.Recommended.InstallCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}" />
                                                        </Grid>
                                                    </ContentControl>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Каталог приложений" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,10" />
                        <ItemsControl ItemsSource="{Binding Apps.Apps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ContentControl Style="{StaticResource HoverCard}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding Status}" FontSize="12" Margin="0,4,0,0" Foreground="{DynamicResource AccentBrush}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Скачать и установить" VerticalAlignment="Center" Margin="16,0,0,0"
                                                    Command="{Binding DataContext.Apps.InstallAppCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </ContentControl>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Zapret (Flowseal)" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,8" />
                        <ContentControl Style="{StaticResource HoverCard}">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" Style="{StaticResource SecondaryText}"
                                           Text="Обход блокировок Discord/YouTube. Уже установленный Zapret находится автоматически (диски, процессы, службы); скачивать нужно, только если его нет. Источник: GitHub Flowseal/zapret-discord-youtube." />
                                <TextBlock Text="{Binding Apps.ZapretStatusText}" Margin="0,10,0,12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource AccentBrush}" />
                                <WrapPanel>
                                    <Button Content="Найти на ПК" Style="{StaticResource AccentButton}" Margin="0,0,8,8"
                                            Command="{Binding Apps.ZapretLocateCommand}"
                                            ToolTip="Поиск уже установленного Zapret по всем дискам, процессам и службам" />
                                    <Button Content="Указать папку…" Margin="0,0,8,8" Command="{Binding Apps.ZapretBrowseCommand}"
                                            ToolTip="Выбрать папку, где уже лежит Zapret (service.bat и bin\winws.exe)" />
                                    <Button Content="Скачать и установить" Margin="0,0,8,8"
                                            Command="{Binding Apps.ZapretInstallCommand}"
                                            ToolTip="Доступно, только если Zapret на компьютере не найден" />
                                    <Button Content="Запустить службу" Margin="0,0,8,8" Command="{Binding Apps.ZapretStartCommand}" />
                                    <Button Content="Остановить" Margin="0,0,8,8" Command="{Binding Apps.ZapretStopCommand}" />
                                    <Button Content="Удалить" Margin="0,0,8,8" Command="{Binding Apps.ZapretUninstallCommand}" />
                                    <Button Content="Обновить" Margin="0,0,8,8" Command="{Binding Apps.RefreshCommand}" />
                                </WrapPanel>
                            </StackPanel>
                        </ContentControl>

                        <TextBlock Text="TG WS Proxy (Flowseal)" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,8" />
                        <ContentControl Style="{StaticResource HoverCard}">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" Style="{StaticResource SecondaryText}"
                                           Text="Локальный MTProto-прокси через WebSocket для Telegram Desktop (Flowseal/tg-ws-proxy). Установленный экземпляр находится автоматически. Не путать с Zapret." />
                                <TextBlock Text="{Binding Apps.TgStatusText}" Margin="0,10,0,12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource AccentBrush}" />
                                <WrapPanel>
                                    <Button Content="Найти на ПК" Style="{StaticResource AccentButton}" Margin="0,0,8,8"
                                            Command="{Binding Apps.TgLocateCommand}"
                                            ToolTip="Поиск уже установленного TG WS Proxy по всем дискам, процессам и автозагрузке" />
                                    <Button Content="Указать exe…" Margin="0,0,8,8" Command="{Binding Apps.TgBrowseCommand}"
                                            ToolTip="Выбрать TgWsProxy_windows.exe, который уже есть на компьютере" />
                                    <Button Content="Скачать и установить" Margin="0,0,8,8"
                                            Command="{Binding Apps.TgInstallCommand}"
                                            ToolTip="Доступно, только если TG WS Proxy на компьютере не найден" />
                                    <Button Content="Запустить" Margin="0,0,8,8" Command="{Binding Apps.TgStartCommand}" />
                                    <Button Content="Остановить" Margin="0,0,8,8" Command="{Binding Apps.TgStopCommand}" />
                                    <Button Content="Удалить" Margin="0,0,8,8" Command="{Binding Apps.TgUninstallCommand}" />
                                </WrapPanel>
                            </StackPanel>
                        </ContentControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Страница «Настройки» — UI в WinOptimizer.Settings.dll -->
            <settings:SettingsPage Visibility="{Binding IsSettingsPage, Converter={StaticResource BoolToVis}}"
                                   DataContext="{Binding}" />


    </Grid>
</UserControl>
