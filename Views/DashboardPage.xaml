<UserControl x:Class="WinOptimizer.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WinOptimizer.Views">
    <UserControl.Resources>
        <Style x:Key="MetricCard" TargetType="Border" BasedOn="{StaticResource BorderCard}">
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="MinWidth" Value="140" />
            <Setter Property="MinHeight" Value="128" />
        </Style>
        <Style x:Key="IntervalChip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chip" CornerRadius="8" Padding="12,6"
                                Background="{DynamicResource BgCardBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource BgCardHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="#243044" />
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource OverlayScroll}" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
        <StackPanel Margin="28,24,16,16">
            <TextBlock Text="Главная" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource SecondaryText}" Margin="0,6,0,18"
                       Text="Состояние ПК, быстрые действия и последние операции. Мониторинг работает только на этой странице." />

            <TextBlock Text="{Binding Dashboard.StatusSummary}" FontWeight="SemiBold" Margin="0,0,0,14"
                       Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" />

            <UniformGrid Columns="4" Margin="0,0,0,12">
                <Border Style="{StaticResource MetricCard}" Margin="0,0,10,10">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="32" Height="32">
                                <Border Background="{DynamicResource AccentBrush}" Opacity="0.16" CornerRadius="10"/>
                                <Viewbox Width="16" Height="16">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M7,7 H17 V17 H7 Z M10,3 V7 M14,3 V7 M10,17 V21 M14,17 V21 M3,10 H7 M3,14 H7 M17,10 H21 M17,14 H21"
                                              Stroke="{DynamicResource AccentBrush}"
                                              StrokeThickness="1.8" StrokeLineJoin="Round"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Canvas>
                                </Viewbox>
                            </Grid>
                            <TextBlock Text="Процессор" Style="{StaticResource SecondaryText}"
                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <TextBlock Text="{Binding Dashboard.CpuText}" FontSize="30" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Dashboard.CpuSubtitle}" Style="{StaticResource SecondaryText}"
                                   FontSize="12" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource MetricCard}" Margin="0,0,10,10">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Память" Style="{StaticResource SecondaryText}" FontSize="12" />
                        <TextBlock Text="{Binding Dashboard.RamText}" FontSize="15" FontWeight="SemiBold" Margin="0,12,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="0,0,10,10">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Темп. ЦП" Style="{StaticResource SecondaryText}" FontSize="12" />
                        <TextBlock Text="{Binding Dashboard.CpuTempText}" FontSize="22" FontWeight="SemiBold" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="0,0,0,10">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Темп. GPU" Style="{StaticResource SecondaryText}" FontSize="12" />
                        <TextBlock Text="{Binding Dashboard.GpuTempText}" FontSize="22" FontWeight="SemiBold" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Обновлять" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <RadioButton GroupName="DashInterval" Style="{StaticResource IntervalChip}" Content="2 с"
                                 IsChecked="{Binding Dashboard.IsInterval2, Mode=OneWay}"
                                 Command="{Binding Dashboard.SetIntervalCommand}" CommandParameter="2" />
                    <RadioButton GroupName="DashInterval" Style="{StaticResource IntervalChip}" Content="3 с"
                                 IsChecked="{Binding Dashboard.IsInterval3, Mode=OneWay}"
                                 Command="{Binding Dashboard.SetIntervalCommand}" CommandParameter="3" />
                    <RadioButton GroupName="DashInterval" Style="{StaticResource IntervalChip}" Content="5 с"
                                 IsChecked="{Binding Dashboard.IsInterval5, Mode=OneWay}"
                                 Command="{Binding Dashboard.SetIntervalCommand}" CommandParameter="5" />
                    <RadioButton GroupName="DashInterval" Style="{StaticResource IntervalChip}" Content="10 с"
                                 IsChecked="{Binding Dashboard.IsInterval10, Mode=OneWay}"
                                 Command="{Binding Dashboard.SetIntervalCommand}" CommandParameter="10" />
                    <TextBlock Text="{Binding Dashboard.IntervalHint}" Style="{StaticResource SecondaryText}"
                               VerticalAlignment="Center" Margin="8,0,0,0" FontSize="12" />
                </StackPanel>
                <Button Grid.Column="1" Content="Обновить сейчас" Command="{Binding Dashboard.RefreshCommand}" />
            </Grid>

            <TextBlock Text="Быстрые действия" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10" />
            <WrapPanel Margin="0,0,0,20">
                <Button Content="Оптимизация" Command="{Binding Dashboard.OpenTweaksCommand}" Margin="0,0,8,8" />
                <Button Content="Обслуживание" Command="{Binding Dashboard.OpenMaintenanceCommand}" Margin="0,0,8,8" />
                <Button Content="Игры" Command="{Binding Dashboard.OpenGamesCommand}" Margin="0,0,8,8" />
                <Button Content="Мой ПК" Command="{Binding Dashboard.OpenSystemCommand}" Margin="0,0,8,8" />
            </WrapPanel>

            <TextBlock Text="Профили оптимизации" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10" />
            <TextBlock Style="{StaticResource SecondaryText}" Margin="0,0,0,10" TextWrapping="Wrap"
                       Text="Встроенные наборы твиков. Применение — через раздел «Оптимизация системы»." />
            <ItemsControl ItemsSource="{Binding Dashboard.Profiles}" Margin="0,0,0,20">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource BorderCard}">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Description}" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Последние операции" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10" />
            <ItemsControl ItemsSource="{Binding Dashboard.RecentOperations}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource BorderCard}" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource SecondaryText}" FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Outcome}" Style="{StaticResource SecondaryText}"
                                           VerticalAlignment="Center" Margin="12,0,0,0" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
