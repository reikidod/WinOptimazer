<Window x:Class="WinOptimizer.Views.DiagnosticConsoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Диагностика WinOptimizer"
        Width="920" Height="680" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgWindowBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock x:Name="DescriptionText" Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>

        <WrapPanel x:Name="InputLatencyActions" Grid.Row="1" Margin="0,0,0,10" Visibility="Collapsed">
            <Button Content="Сканировать HID" Tag="scan" Click="RunMode_Click" Margin="0,0,8,8"/>
            <Button Content="Автопоиск мыши" Tag="autodetect" Click="RunMode_Click" Margin="0,0,8,8"/>
            <Button Content="Контроллер донгла" Tag="dongle" Click="RunMode_Click" Margin="0,0,8,8"/>
            <Button Content="Измерить polling rate" Tag="measure" Click="RunMode_Click" Margin="0,0,8,8"/>
            <Button Content="Безопасное применение" Tag="safeapply" Click="RunMode_Click" Margin="0,0,8,8"/>
            <Button Content="Применить профиль" Tag="applynow" Click="RunMode_Click" Margin="0,0,8,8"/>
            <Button Content="Откатить" Tag="rollback" Click="RunMode_Click" Margin="0,0,8,8"/>
            <Button Content="Статус и журнал" Tag="status" Click="RunMode_Click" Margin="0,0,8,8"/>
            <Button Content="Установить службу" Tag="install" Click="RunMode_Click" Margin="0,0,8,8"/>
            <Button Content="Удалить службу" Tag="uninstall" Click="RunMode_Click" Margin="0,0,8,8"/>
            <Button Content="Редактировать профиль" Click="EditProfile_Click" Margin="0,0,8,8"/>
        </WrapPanel>

        <TextBox x:Name="OutputBox" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True"
                 TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontFamily="Cascadia Mono, Consolas" FontSize="12"
                 Background="{DynamicResource BgCardBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                 BorderBrush="{DynamicResource BorderBrush}" Padding="12"/>

        <TextBlock x:Name="StatusText" Grid.Row="3" Foreground="{DynamicResource TextSecondaryBrush}"
                   Margin="0,8,0,8" Text="Готово."/>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="InputBox" Grid.Column="0" MinHeight="36" Padding="8"
                     VerticalContentAlignment="Center" KeyDown="InputBox_KeyDown"
                     ToolTip="Введите ответ или команду для текущего сценария"/>
            <Button Grid.Column="1" Content="Отправить" MinWidth="100" Margin="8,0,0,0"
                    Click="SendInput_Click"/>
            <Button Grid.Column="2" Content="Закрыть" MinWidth="90" Margin="8,0,0,0"
                    Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>
