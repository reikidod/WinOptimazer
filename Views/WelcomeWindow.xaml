<Window x:Class="WinOptimizer.Views.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinOptimizer"
        Width="620" Height="400"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        Topmost="True">

    <Border Margin="26" CornerRadius="22" BorderThickness="1" BorderBrush="#3A5B8FD9" ClipToBounds="True"
            SnapsToDevicePixels="True">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FF0D1017" Offset="0" />
                <GradientStop Color="#FF121A2A" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="44" ShadowDepth="0" Color="#4C86E0" Opacity="0.55" />
        </Border.Effect>

        <Grid>
            <!-- Синяя дуга: заливка-«рассвет», светящаяся линия и тонкая яркая линия -->
            <Grid x:Name="ArcLayer" IsHitTestVisible="False" Opacity="0" RenderTransformOrigin="0.5,1">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="ArcShift" Y="70" />
                </Grid.RenderTransform>

                <Path Data="M -90,440 A 520,520 0 0 1 700,440 Z" Stretch="None">
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Color="#552F6BD1" Offset="0" />
                            <GradientStop Color="#222A4F96" Offset="0.35" />
                            <GradientStop Color="#00121A2A" Offset="1" />
                        </LinearGradientBrush>
                    </Path.Fill>
                </Path>

                <Path x:Name="ArcGlow" Data="M -90,440 A 520,520 0 0 1 700,440" Stroke="#7FB2FF" StrokeThickness="10"
                      Stretch="None" Opacity="0.55">
                    <Path.Effect>
                        <BlurEffect Radius="16" />
                    </Path.Effect>
                </Path>

                <Path Data="M -90,440 A 520,520 0 0 1 700,440" StrokeThickness="2.5" Stretch="None">
                    <Path.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#005B9BFF" Offset="0" />
                            <GradientStop Color="#FF8FC0FF" Offset="0.5" />
                            <GradientStop Color="#005B9BFF" Offset="1" />
                        </LinearGradientBrush>
                    </Path.Stroke>
                </Path>
            </Grid>

            <!-- Мягкое свечение за текстом -->
            <Ellipse Width="420" Height="190" Opacity="0.35" IsHitTestVisible="False" VerticalAlignment="Top" Margin="0,34,0,0">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#663B7DD9" Offset="0" />
                        <GradientStop Color="#0012141A" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="32,58,32,0">
                <TextBlock x:Name="TitleText" Text="WinOptimizer" Opacity="0"
                           FontSize="14" FontWeight="SemiBold" Foreground="#B0C6E4FF"
                           HorizontalAlignment="Center" Margin="0,0,0,16" />

                <TextBlock x:Name="GreetingText" Text="Добро пожаловать" Opacity="0"
                           FontSize="32" FontWeight="SemiBold" Foreground="White"
                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="460"
                           HorizontalAlignment="Center" LineHeight="40">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="GreetingShift" Y="22" />
                    </TextBlock.RenderTransform>
                </TextBlock>

                <StackPanel x:Name="StatusPanel" Opacity="0" Margin="0,24,0,0" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock x:Name="StatusText" Text="Подготавливаю систему" FontSize="12.5"
                                   Foreground="#99C2D6F2" VerticalAlignment="Center" />
                        <!-- Три точки по очереди подпрыгивают вместо статичного «…» -->
                        <Ellipse x:Name="Dot1" Width="4" Height="4" Fill="#99C2D6F2" Margin="5,6,0,0">
                            <Ellipse.RenderTransform><TranslateTransform x:Name="Dot1Shift" /></Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse x:Name="Dot2" Width="4" Height="4" Fill="#99C2D6F2" Margin="4,6,0,0">
                            <Ellipse.RenderTransform><TranslateTransform x:Name="Dot2Shift" /></Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse x:Name="Dot3" Width="4" Height="4" Fill="#99C2D6F2" Margin="4,6,0,0">
                            <Ellipse.RenderTransform><TranslateTransform x:Name="Dot3Shift" /></Ellipse.RenderTransform>
                        </Ellipse>
                    </StackPanel>
                    <Border Width="170" Height="3" CornerRadius="1.5" Background="#22FFFFFF" Margin="0,12,0,0">
                        <Border x:Name="ProgressFill" CornerRadius="1.5" HorizontalAlignment="Left" Width="170"
                                RenderTransformOrigin="0,0.5">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#5B9BFF" Offset="0" />
                                    <GradientStop Color="#A9D0FF" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="ProgressScale" ScaleX="0" />
                            </Border.RenderTransform>
                        </Border>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
