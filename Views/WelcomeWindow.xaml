<Window x:Class="WinOptimizer.Views.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinOptimizer"
        Width="640" Height="420"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        Topmost="True">

    <!-- Все цвета берутся из текущей темы (ThemeManager), поэтому окно совпадает с основным интерфейсом. -->
    <!-- Поле вокруг рамки (36) больше радиуса тени + сдвига (30 + 6), поэтому тень не обрезается границей окна
         и не выглядит «отделившимся» прямоугольником при перетаскивании. Тень лежит на отдельной подложке:
         размытие считается один раз, а анимация дуги внутри окна его не перерисовывает. -->
    <Grid Margin="36">
    <Border CornerRadius="22" IsHitTestVisible="False" Background="{DynamicResource BgWindowBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="6" Direction="270" Color="Black" Opacity="0.5" RenderingBias="Performance" />
        </Border.Effect>
    </Border>

    <Border CornerRadius="22" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
            Background="{DynamicResource BgWindowBrush}" SnapsToDevicePixels="True">

        <Grid>
            <Grid.Clip>
                <RectangleGeometry Rect="0,0,566,346" RadiusX="21" RadiusY="21" />
            </Grid.Clip>

            <!-- Слегка подсвеченный к низу фон -->
            <Border IsHitTestVisible="False" Background="{DynamicResource BgSidebarBrush}">
                <Border.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="Transparent" Offset="0.15" />
                        <GradientStop Color="Black" Offset="1" />
                    </LinearGradientBrush>
                </Border.OpacityMask>
            </Border>

            <!-- Дуга: S-образная кривая от нижнего левого угла к верхнему правому. Рисуется при появлении,
                 затем по ней бежит блик, а вся группа плавно «плавает». -->
            <Grid x:Name="ArcLayer" IsHitTestVisible="False" Opacity="0">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <TranslateTransform x:Name="ArcShift" Y="40" />
                        <TranslateTransform x:Name="ArcFloat" />
                    </TransformGroup>
                </Grid.RenderTransform>

                <!-- Лёгкая заливка под кривой. Намеренно шире окна: вся дуга «плавает» (до 9 px вверх и 12 px вправо)
                     и со вплотную обрезанной заливкой у нижнего и левого края появлялась тёмная полоса. -->
                <Path Data="M -80,420 L -80,332 L -10,332 C 90,296 200,290 290,262 C 380,234 390,130 430,72 S 500,12 560,-4 L 660,-4 L 660,420 Z" Stretch="None"
                      Fill="{DynamicResource AccentBrush}" Opacity="0.08" />

                <!-- Параллельные тонкие линии, смещённые вниз-вправо -->
                <Path Data="M -10,332 C 90,296 200,290 290,262 C 380,234 390,130 430,72 S 500,12 560,-4" Stretch="None" Stroke="{DynamicResource AccentBrush}"
                      StrokeThickness="1" Opacity="0.24">
                    <Path.RenderTransform><TranslateTransform X="16" Y="22" /></Path.RenderTransform>
                </Path>
                <Path Data="M -10,332 C 90,296 200,290 290,262 C 380,234 390,130 430,72 S 500,12 560,-4" Stretch="None" Stroke="{DynamicResource AccentBrush}"
                      StrokeThickness="1" Opacity="0.12">
                    <Path.RenderTransform><TranslateTransform X="32" Y="44" /></Path.RenderTransform>
                </Path>

                <!-- Свечение главной линии («дышит») -->
                <Path x:Name="ArcGlow" Data="M -10,332 C 90,296 200,290 290,262 C 380,234 390,130 430,72 S 500,12 560,-4" Stretch="None"
                      Stroke="{DynamicResource AccentBrush}" StrokeThickness="8" Opacity="0.4">
                    <Path.Effect>
                        <BlurEffect Radius="14" />
                    </Path.Effect>
                </Path>

                <!-- Главная линия: «прорисовывается» через StrokeDashOffset -->
                <Path x:Name="ArcMain" Data="M -10,332 C 90,296 200,290 290,262 C 380,234 390,130 430,72 S 500,12 560,-4" Stretch="None"
                      Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" Opacity="0.7"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      StrokeDashArray="600 600" StrokeDashOffset="600" />

                <!-- Бегущий блик -->
                <Path Data="M -10,332 C 90,296 200,290 290,262 C 380,234 390,130 430,72 S 500,12 560,-4" Stretch="None"
                      Stroke="{DynamicResource AccentBrush}" StrokeThickness="3.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                    <Path.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <LinearGradientBrush.RelativeTransform>
                                <TranslateTransform x:Name="ShimmerShift" X="-1" />
                            </LinearGradientBrush.RelativeTransform>
                            <GradientStop Color="Transparent" Offset="0.40" />
                            <GradientStop Color="Black" Offset="0.5" />
                            <GradientStop Color="Transparent" Offset="0.60" />
                        </LinearGradientBrush>
                    </Path.OpacityMask>
                </Path>
            </Grid>

            <!-- Мягкое свечение за текстом -->
            <Ellipse Width="420" Height="190" Opacity="0.14" IsHitTestVisible="False"
                     VerticalAlignment="Top" Margin="0,34,0,0" Fill="{DynamicResource AccentBrush}">
                <Ellipse.OpacityMask>
                    <RadialGradientBrush>
                        <GradientStop Color="Black" Offset="0" />
                        <GradientStop Color="Transparent" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.OpacityMask>
            </Ellipse>

            <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="32,58,32,0">
                <TextBlock x:Name="TitleText" Text="WinOptimizer" Opacity="0"
                           FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,16" />

                <TextBlock x:Name="GreetingText" Text="Добро пожаловать" Opacity="0"
                           FontSize="32" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="460"
                           HorizontalAlignment="Center" LineHeight="40">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="GreetingShift" Y="22" />
                    </TextBlock.RenderTransform>
                </TextBlock>

                <StackPanel x:Name="StatusPanel" Opacity="0" Margin="0,24,0,0" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock x:Name="StatusText" Text="Подготавливаю систему" FontSize="12.5"
                                   Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" />
                        <!-- Три точки по очереди подпрыгивают вместо статичного «…» -->
                        <Ellipse x:Name="Dot1" Width="4" Height="4" Fill="{DynamicResource AccentBrush}" Margin="5,6,0,0">
                            <Ellipse.RenderTransform><TranslateTransform x:Name="Dot1Shift" /></Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse x:Name="Dot2" Width="4" Height="4" Fill="{DynamicResource AccentBrush}" Margin="4,6,0,0">
                            <Ellipse.RenderTransform><TranslateTransform x:Name="Dot2Shift" /></Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse x:Name="Dot3" Width="4" Height="4" Fill="{DynamicResource AccentBrush}" Margin="4,6,0,0">
                            <Ellipse.RenderTransform><TranslateTransform x:Name="Dot3Shift" /></Ellipse.RenderTransform>
                        </Ellipse>
                    </StackPanel>
                    <Border Width="170" Height="4" CornerRadius="2" Background="{DynamicResource TrackOffBrush}" Margin="0,12,0,0">
                        <Border x:Name="ProgressFill" CornerRadius="2" HorizontalAlignment="Left" Width="170"
                                Background="{DynamicResource AccentBrush}" RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="ProgressScale" ScaleX="0" />
                            </Border.RenderTransform>
                        </Border>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
    </Grid>
</Window>
