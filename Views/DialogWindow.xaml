<Window x:Class="WinOptimizer.Views.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Height"
        Width="588"
        MaxHeight="640"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="14"
        UseLayoutRounding="True"
        AllowsTransparency="True"
        MouseLeftButtonDown="OnDragWindow">

    <Border x:Name="Root" RenderTransformOrigin="0.5,0.5" Margin="24"
            CornerRadius="18" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            Background="{DynamicResource BgWindowBrush}" SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="10" Direction="270" Opacity="0.5" Color="Black" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Шапка -->
            <Border x:Name="HeaderBar" CornerRadius="18,18,0,0" Padding="24,20">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop x:Name="HeaderColor0" Color="#3A4A66" Offset="0" />
                        <GradientStop x:Name="HeaderColor1" Color="#2A3344" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="52" Height="52" CornerRadius="16" Background="#28FFFFFF"
                            VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock x:Name="IconText" Text="💾" FontSize="24"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" FontSize="19" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Foreground="White" />
                        <TextBlock x:Name="SubtitleText" FontSize="12.5" Margin="0,5,0,0"
                                   Foreground="#B8E6E7EA" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Текст -->
            <ScrollViewer Style="{StaticResource OverlayScroll}" Grid.Row="1"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          MaxHeight="260" Margin="20,14,20,0" Padding="0,0,4,0">
                <Border Background="#14FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1"
                        CornerRadius="12" Padding="16,14">
                    <TextBlock x:Name="MessageText"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" LineHeight="22" />
                </Border>
            </ScrollViewer>

            <!-- Кнопки: слева «Не применять», справа действия -->
            <Border Grid.Row="2" Margin="0,14,0,0" Padding="16,14" Background="#10FFFFFF"
                    CornerRadius="0,0,18,18" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="CancelButton" MinWidth="120" Padding="14,9"
                            HorizontalAlignment="Left" IsCancel="True" Click="OnCancel"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource TextDimBrush}" Cursor="Hand" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="SecondaryButton" MinWidth="140" Margin="0,0,10,0"
                                Padding="14,9" Click="OnSecondary" />
                        <Button x:Name="PrimaryButton" MinWidth="160" Padding="16,9"
                                IsDefault="True" Style="{StaticResource AccentButton}" Click="OnPrimary" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
