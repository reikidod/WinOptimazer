<UserControl x:Class="WinOptimizer.Views.GamesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WinOptimizer.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <Grid local:Motion.PageTransition="True" Margin="32,28,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,16,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Игры" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Игровые твики и оптимизации" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Сбросить" Margin="0,0,8,0" Command="{Binding ResetSelectionCommand}" />
                <Button Content="Применить" Style="{StaticResource AccentButton}" Command="{Binding ApplyCommand}" />
            </StackPanel>
        </Grid>
        <ScrollViewer Style="{StaticResource OverlayScroll}" local:Motion.SmoothScroll="True" Grid.Row="1"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding FilteredTweaks}" Margin="0,0,16,8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ContentControl Style="{StaticResource HoverCard}" Margin="0,0,0,10" local:Motion.CardEntrance="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="12.5" LineHeight="18"
                                               Margin="0,4,0,0" Style="{StaticResource SecondaryText}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          Style="{StaticResource ToggleSwitch}"
                                          IsEnabled="{Binding IsAvailable}"
                                          AutomationProperties.Name="{Binding Title}" />
                            </Grid>
                        </ContentControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
