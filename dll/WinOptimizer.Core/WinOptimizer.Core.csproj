<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WinOptimizer.Infrastructure</RootNamespace>
    <AssemblyName>WinOptimizer.Core</AssemblyName>
    <UseWPF>true</UseWPF>
    <!-- Готовые DLL складываем в /bin у корня репозитория -->
    <OutputPath>$(MSBuildThisFileDirectory)..\..\bin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="WinOptimizer" />
    <InternalsVisibleTo Include="WinOptimizer.Settings" />
    <InternalsVisibleTo Include="WinOptimizer.Tests" />
  </ItemGroup>
</Project>
