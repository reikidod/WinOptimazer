<UserControl x:Class="WinOptimizer.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
        <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BgCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="20,18" />
            <Setter Property="Margin" Value="0,0,16,12" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BgCardHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SettingsSectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Margin" Value="2,20,0,10" />
        </Style>
    </UserControl.Resources>
            <Grid Margin="28,24,12,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Margin="0,0,16,20">
                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="6" Padding="9,4"
                            HorizontalAlignment="Left" Margin="0,0,0,10">
                        <TextBlock Text="ПЕРСОНАЛИЗАЦИЯ" FontSize="10.5" FontWeight="Bold"
                                   Foreground="White" />
                    </Border>
                    <TextBlock Text="Настройки" Style="{StaticResource PageTitle}" FontSize="28" />
                    <TextBlock Style="{StaticResource SecondaryText}" Margin="0,6,0,0" FontSize="13"
                               Text="Настройте WinOptimizer под себя — изменения применяются сразу." />
                </StackPanel>

                <ScrollViewer Style="{StaticResource OverlayScroll}" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="Запуск" Style="{StaticResource SettingsSectionTitle}" />
                        <Border Style="{StaticResource SettingsCard}" Margin="0,0,16,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Запускать вместе с Windows" FontSize="14.5" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource SecondaryText}" FontSize="12.5" Margin="0,3,0,0" Text="Приложение откроется после входа в систему с правами администратора, без окна подтверждения. Создаётся задача в планировщике Windows; выключите переключатель, чтобы её удалить." />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                          IsChecked="{Binding Settings.StartWithWindows, Mode=TwoWay}" AutomationProperties.Name="Запускать вместе с Windows" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsCard}" Margin="0,0,16,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Приветственное окно" FontSize="14.5" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource SecondaryText}" FontSize="12.5" Margin="0,3,0,0" Text="Короткая заставка с приветствием при запуске. Отключите, если хотите открывать приложение сразу." />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                          IsChecked="{Binding Settings.ShowWelcome, Mode=TwoWay}" AutomationProperties.Name="Приветственное окно" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsCard}" Margin="0,0,16,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Проверять обновления при запуске" FontSize="14.5" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource SecondaryText}" FontSize="12.5" Margin="0,3,0,0" Text="Приложение проверит GitHub Releases и предложит установить новую версию. Проверить вручную можно кнопкой слева внизу." />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                          IsChecked="{Binding Settings.CheckUpdatesOnStartup, Mode=TwoWay}" AutomationProperties.Name="Проверять обновления при запуске" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsCard}" Margin="0,0,16,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Бета-версии" FontSize="14.5" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource SecondaryText}" FontSize="12.5" Margin="0,3,0,0"
                                               Text="Получать обновления из ветки beta: там новые функции раньше, но возможны ошибки. Выключите, чтобы вернуться на стабильную версию." />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                          IsChecked="{Binding Settings.UseBetaChannel, Mode=TwoWay}" AutomationProperties.Name="Бета-версии" />
                            </Grid>
                        </Border>

                        <TextBlock Text="Безопасность" Style="{StaticResource SettingsSectionTitle}" />
                        <Border Style="{StaticResource SettingsCard}" Margin="0,0,16,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Предлагать точку восстановления" FontSize="14.5" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource SecondaryText}" FontSize="12.5" Margin="0,3,0,0" Text="Перед системными твиками приложение спросит, создать ли снимок Windows. Отключайте, только если уверены: откат через снимок станет недоступным." />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                          IsChecked="{Binding Settings.AskRestorePoint, Mode=TwoWay}" AutomationProperties.Name="Предлагать точку восстановления" />
                            </Grid>
                        </Border>

                        <TextBlock Text="Вкладки" Style="{StaticResource SettingsSectionTitle}" />
                        <Border Style="{StaticResource SettingsCard}" Margin="0,0,16,10">
                            <StackPanel>
                                <TextBlock Text="Какие вкладки показывать" FontSize="14.5" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource SecondaryText}" FontSize="12.5" Margin="0,3,0,6" TextWrapping="Wrap"
                                           Text="Уберите ненужные разделы из боковой панели. Включите переключатель, чтобы вкладка вернулась. «Настройки» скрыть нельзя." />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Оптимизация системы" FontSize="13.5" />
                                        <TextBlock Style="{StaticResource SecondaryText}" FontSize="12" Text="Твики реестра, служб и схемы питания" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                              IsChecked="{Binding Settings.ShowTweaksTab, Mode=TwoWay}" AutomationProperties.Name="Показывать вкладку «Оптимизация системы»" />
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Удаление программ" FontSize="13.5" />
                                        <TextBlock Style="{StaticResource SecondaryText}" FontSize="12" Text="Удаление лишних приложений Windows" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                              IsChecked="{Binding Settings.ShowDebloatTab, Mode=TwoWay}" AutomationProperties.Name="Показывать вкладку «Удаление программ»" />
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Установка программ" FontSize="13.5" />
                                        <TextBlock Style="{StaticResource SecondaryText}" FontSize="12" Text="Каталог программ для установки" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                              IsChecked="{Binding Settings.ShowAppsTab, Mode=TwoWay}" AutomationProperties.Name="Показывать вкладку «Установка программ»" />
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Microsoft Store" FontSize="13.5" />
                                        <TextBlock Style="{StaticResource SecondaryText}" FontSize="12" Text="Приложения из магазина через winget" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                              IsChecked="{Binding Settings.ShowStoreTab, Mode=TwoWay}" AutomationProperties.Name="Показывать вкладку «Microsoft Store»" />
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Игры" FontSize="13.5" />
                                        <TextBlock Style="{StaticResource SecondaryText}" FontSize="12" Text="Поиск игр и подбор настроек" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                              IsChecked="{Binding Settings.ShowGamesTab, Mode=TwoWay}" AutomationProperties.Name="Показывать вкладку «Игры»" />
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Мой ПК" FontSize="13.5" />
                                        <TextBlock Style="{StaticResource SecondaryText}" FontSize="12" Text="Характеристики компьютера" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                              IsChecked="{Binding Settings.ShowSystemTab, Mode=TwoWay}" AutomationProperties.Name="Показывать вкладку «Мой ПК»" />
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Обслуживание" FontSize="13.5" />
                                        <TextBlock Style="{StaticResource SecondaryText}" FontSize="12" Text="Временные файлы, автозагрузка и откат системы" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                              IsChecked="{Binding Settings.ShowMaintenanceTab, Mode=TwoWay}" AutomationProperties.Name="Показывать вкладку «Обслуживание»" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Тема и цвета" Style="{StaticResource SettingsSectionTitle}" />
                        <Border Style="{StaticResource SettingsCard}" Margin="0,0,16,10">
                            <StackPanel>
                                <TextBlock Text="Тема приложения" FontSize="14.5" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource SecondaryText}" FontSize="12.5" Margin="0,3,0,0"
                                           Text="Цвета применяются сразу, перезапуск не нужен." />
                                <ItemsControl ItemsSource="{Binding Settings.ThemeOptions}" Margin="0,10,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <RadioButton GroupName="ThemePick" Margin="0,0,8,8"
                                                         IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                         Command="{Binding SelectCommand}"
                                                         ToolTip="{Binding Name}">
                                                <RadioButton.Template>
                                                    <ControlTemplate TargetType="RadioButton">
                                                        <Border x:Name="Bd" CornerRadius="10" Padding="12,10" BorderThickness="1"
                                                                Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderBrush}" Cursor="Hand">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Border Width="18" Height="18" CornerRadius="4" Margin="0,0,8,0"
                                                                        Background="{Binding SwatchBrush}" />
                                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="13" />
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                <Setter TargetName="Bd" Property="Background" Value="#243044" />
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgCardHoverBrush}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </RadioButton.Template>
                                            </RadioButton>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Интерфейс" Style="{StaticResource SettingsSectionTitle}" />
                        <Border Style="{StaticResource SettingsCard}" Margin="0,0,16,10">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="Анимации" FontSize="14.5" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource SecondaryText}" FontSize="12.5" Margin="0,3,0,0" Text="Плавные переходы между страницами и карточками." />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                              IsChecked="{Binding Settings.Animations, Mode=TwoWay}" AutomationProperties.Name="Анимации" />
                                </Grid>
                                <TextBlock Text="Масштаб интерфейса" FontSize="14.5" FontWeight="SemiBold" Margin="0,16,0,0" />
                                <TextBlock Style="{StaticResource SecondaryText}" FontSize="12.5" Margin="0,3,0,8" Text="{Binding Settings.ScaleText}" />
                                <Slider Minimum="90" Maximum="125" TickFrequency="5" IsSnapToTickEnabled="True"
                                        Value="{Binding Settings.UiScalePercent, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Фон" Style="{StaticResource SettingsSectionTitle}" />
                        <Border Style="{StaticResource SettingsCard}" Margin="0,0,16,10">
                            <StackPanel>
                                <TextBlock Text="Картинка фона" FontSize="14.5" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource SecondaryText}" FontSize="12.5" Margin="0,3,0,10"
                                           Text="Размытие и затемнение помогают читать текст поверх фото." />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Content="Выбрать…" Command="{Binding Settings.PickBackgroundCommand}" Margin="0,0,8,0" />
                                    <Button Content="Убрать" Command="{Binding Settings.ClearBackgroundCommand}"
                                            Visibility="{Binding Settings.HasBackground, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Settings.BackgroundName}" Style="{StaticResource SecondaryText}" FontSize="12"
                                           Visibility="{Binding Settings.HasBackground, Converter={StaticResource BoolToVis}}" Margin="0,0,0,10" />
                                <TextBlock Text="Размытие" FontSize="13" Margin="0,0,0,4" />
                                <Slider Minimum="0" Maximum="100" Value="{Binding Settings.BackgroundBlur, Mode=TwoWay}" />
                                <TextBlock Text="Затемнение" FontSize="13" Margin="0,10,0,4" />
                                <Slider Minimum="0" Maximum="90" Value="{Binding Settings.BackgroundDim, Mode=TwoWay}" />
                                <TextBlock Text="Непрозрачность карточек" FontSize="13" Margin="0,10,0,4" />
                                <Slider Minimum="50" Maximum="100" Value="{Binding Settings.CardOpacity, Mode=TwoWay}" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="Прозрачность панелей" FontSize="14.5" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource SecondaryText}" FontSize="12.5" Margin="0,3,0,0" Text="Боковая панель и модули слегка просвечивают фон." />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                              IsChecked="{Binding Settings.TransparencyEffectsEnabled, Mode=TwoWay}" AutomationProperties.Name="Прозрачность панелей" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
</UserControl>
