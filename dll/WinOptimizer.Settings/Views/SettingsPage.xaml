<UserControl x:Class="WinOptimizer.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
            <Grid Margin="32,28,16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Margin="0,0,16,16">
                    <TextBlock Text="Настройки" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource SecondaryText}" Margin="0,4,0,0"
                               Text="Поведение и внешний вид приложения. Изменения применяются сразу." />
                </StackPanel>

                <ScrollViewer Style="{StaticResource OverlayScroll}" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="Запуск" FontSize="16" FontWeight="SemiBold" Margin="2,0,0,8" />
                        <Border Style="{StaticResource BorderCard}" Margin="0,0,16,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Запускать вместе с Windows" FontSize="14.5" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource SecondaryText}" FontSize="12.5" Margin="0,3,0,0" Text="Приложение откроется после входа в систему с правами администратора, без окна подтверждения. Создаётся задача в планировщике Windows; выключите переключатель, чтобы её удалить." />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                          IsChecked="{Binding Settings.StartWithWindows, Mode=TwoWay}" AutomationProperties.Name="Запускать вместе с Windows" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource BorderCard}" Margin="0,0,16,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Приветственное окно" FontSize="14.5" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource SecondaryText}" FontSize="12.5" Margin="0,3,0,0" Text="Короткая заставка с приветствием при запуске. Отключите, если хотите открывать приложение сразу." />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                          IsChecked="{Binding Settings.ShowWelcome, Mode=TwoWay}" AutomationProperties.Name="Приветственное окно" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource BorderCard}" Margin="0,0,16,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Проверять обновления при запуске" FontSize="14.5" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource SecondaryText}" FontSize="12.5" Margin="0,3,0,0" Text="Приложение проверит GitHub Releases и предложит установить новую версию. Проверить вручную можно кнопкой слева внизу." />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                          IsChecked="{Binding Settings.CheckUpdatesOnStartup, Mode=TwoWay}" AutomationProperties.Name="Проверять обновления при запуске" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource BorderCard}" Margin="0,0,16,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Бета-версии" FontSize="14.5" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource SecondaryText}" FontSize="12.5" Margin="0,3,0,0"
                                               Text="Получать обновления из ветки beta: там новые функции раньше, но возможны ошибки. Выключите, чтобы вернуться на стабильную версию." />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                          IsChecked="{Binding Settings.UseBetaChannel, Mode=TwoWay}" AutomationProperties.Name="Бета-версии" />
                            </Grid>
                        </Border>

                        <TextBlock Text="Безопасность" FontSize="16" FontWeight="SemiBold" Margin="2,14,0,8" />
                        <Border Style="{StaticResource BorderCard}" Margin="0,0,16,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Предлагать точку восстановления" FontSize="14.5" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource SecondaryText}" FontSize="12.5" Margin="0,3,0,0" Text="Перед системными твиками приложение спросит, создать ли снимок Windows. Отключайте, только если уверены: откат через снимок станет недоступным." />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                          IsChecked="{Binding Settings.AskRestorePoint, Mode=TwoWay}" AutomationProperties.Name="Предлагать точку восстановления" />
                            </Grid>
                        </Border>

                        <TextBlock Text="Вкладки" FontSize="16" FontWeight="SemiBold" Margin="2,14,0,8" />
                        <Border Style="{StaticResource BorderCard}" Margin="0,0,16,10">
                            <StackPanel>
                                <TextBlock Text="Какие вкладки показывать" FontSize="14.5" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource SecondaryText}" FontSize="12.5" Margin="0,3,0,6" TextWrapping="Wrap"
                                           Text="Уберите ненужные разделы из боковой панели. Включите переключатель, чтобы вкладка вернулась. «Настройки» скрыть нельзя." />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Оптимизация системы" FontSize="13.5" />
                                        <TextBlock Style="{StaticResource SecondaryText}" FontSize="12" Text="Твики реестра, служб и схемы питания" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                              IsChecked="{Binding Settings.ShowTweaksTab, Mode=TwoWay}" AutomationProperties.Name="Показывать вкладку «Оптимизация системы»" />
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Удаление программ" FontSize="13.5" />
                                        <TextBlock Style="{StaticResource SecondaryText}" FontSize="12" Text="Удаление лишних приложений Windows" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                              IsChecked="{Binding Settings.ShowDebloatTab, Mode=TwoWay}" AutomationProperties.Name="Показывать вкладку «Удаление программ»" />
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Установка программ" FontSize="13.5" />
                                        <TextBlock Style="{StaticResource SecondaryText}" FontSize="12" Text="Каталог программ для установки" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                              IsChecked="{Binding Settings.ShowAppsTab, Mode=TwoWay}" AutomationProperties.Name="Показывать вкладку «Установка программ»" />
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Microsoft Store" FontSize="13.5" />
                                        <TextBlock Style="{StaticResource SecondaryText}" FontSize="12" Text="Приложения из магазина через winget" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                              IsChecked="{Binding Settings.ShowStoreTab, Mode=TwoWay}" AutomationProperties.Name="Показывать вкладку «Microsoft Store»" />
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Игры" FontSize="13.5" />
                                        <TextBlock Style="{StaticResource SecondaryText}" FontSize="12" Text="Поиск игр и подбор настроек" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                              IsChecked="{Binding Settings.ShowGamesTab, Mode=TwoWay}" AutomationProperties.Name="Показывать вкладку «Игры»" />
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Мой ПК" FontSize="13.5" />
                                        <TextBlock Style="{StaticResource SecondaryText}" FontSize="12" Text="Характеристики компьютера" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                              IsChecked="{Binding Settings.ShowSystemTab, Mode=TwoWay}" AutomationProperties.Name="Показывать вкладку «Мой ПК»" />
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Очистка и автозагрузка" FontSize="13.5" />
                                        <TextBlock Style="{StaticResource SecondaryText}" FontSize="12" Text="Очистка диска и управление автозагрузкой" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                              IsChecked="{Binding Settings.ShowMaintenanceTab, Mode=TwoWay}" AutomationProperties.Name="Показывать вкладку «Очистка и автозагрузка»" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Тема и цвета" FontSize="16" FontWeight="SemiBold" Margin="2,14,0,8" />
                        <Border Style="{StaticResource BorderCard}" Margin="0,0,16,10">
                            <StackPanel>
                                <TextBlock Text="Тема приложения" FontSize="14.5" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource SecondaryText}" FontSize="12.5" Margin="0,3,0,0"
                                           Text="Цвета применяются сразу, перезапуск не нужен." />
                                <ItemsControl ItemsSource="{Binding Settings.ThemeOptions}" Margin="0,10,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Margin="0,0,10,10" Padding="0" Width="132"
                                                    Command="{Binding DataContext.Settings.SetThemeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding Id}" AutomationProperties.Name="{Binding Name}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Frame" CornerRadius="10" BorderThickness="2" Padding="8"
                                                                BorderBrush="{DynamicResource BorderBrush}" Background="{Binding BgBrush}">
                                                            <StackPanel>
                                                                <Border Height="34" CornerRadius="6" Background="{Binding CardBrush}">
                                                                    <Ellipse Width="14" Height="14" Fill="{Binding AccentBrush}"
                                                                             HorizontalAlignment="Left" Margin="10,0,0,0" />
                                                                </Border>
                                                                <TextBlock Text="{Binding Name}" Margin="0,8,0,0" FontSize="12.5"
                                                                           Foreground="{Binding TextBrush}" HorizontalAlignment="Center" />
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Frame" Property="Opacity" Value="0.85" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Акцентный цвет" FontSize="14.5" FontWeight="SemiBold" Margin="0,6,0,0" />
                                <TextBlock Style="{StaticResource SecondaryText}" FontSize="12.5" Margin="0,3,0,0"
                                           Text="Цвет кнопок, ссылок и переключателей. «Как в теме» оставляет цвет выбранной темы." />
                                <ItemsControl ItemsSource="{Binding Settings.AccentOptions}" Margin="0,10,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Margin="0,0,8,8" Padding="0"
                                                    Command="{Binding DataContext.Settings.SetAccentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding Id}" AutomationProperties.Name="{Binding Name}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Chip" CornerRadius="16" BorderThickness="2" Padding="10,5"
                                                                BorderBrush="{DynamicResource BorderBrush}" Background="Transparent">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Ellipse Width="14" Height="14" Fill="{Binding Swatch}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding Name}" FontSize="12.5" VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource BgCardHoverBrush}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Фон" FontSize="16" FontWeight="SemiBold" Margin="2,14,0,8" />
                        <Border Style="{StaticResource BorderCard}" Margin="0,0,16,10">
                            <StackPanel>
                                <TextBlock Text="Свой фон" FontSize="14.5" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource SecondaryText}" FontSize="12.5" Margin="0,3,0,0"
                                           Text="Выберите картинку (PNG, JPG, BMP до 40 МБ). Приложение сохранит её копию, так что исходный файл можно удалить." />
                                <WrapPanel Margin="0,10,0,0">
                                    <Button Content="Выбрать картинку…" Style="{StaticResource AccentButton}" Margin="0,0,8,0"
                                            Command="{Binding Settings.PickBackgroundCommand}" />
                                    <Button Content="Убрать фон" Margin="0,0,8,0" Command="{Binding Settings.ClearBackgroundCommand}" />
                                    <TextBlock Text="{Binding Settings.BackgroundName}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" />
                                </WrapPanel>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="52" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Размытие" FontSize="13.5" />
                                        <TextBlock Style="{StaticResource SecondaryText}" FontSize="11.5" Text="0 — чёткая картинка" />
                                    </StackPanel>
                                    <Slider Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                            Margin="12,0" VerticalAlignment="Center" Value="{Binding Settings.BackgroundBlur, Mode=TwoWay}"
                                            AutomationProperties.Name="Размытие" />
                                    <TextBlock Grid.Column="2" Text="{Binding Settings.BackgroundBlur, StringFormat={}{0}%}" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="52" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Затемнение" FontSize="13.5" />
                                        <TextBlock Style="{StaticResource SecondaryText}" FontSize="11.5" Text="Чем темнее, тем лучше виден текст" />
                                    </StackPanel>
                                    <Slider Grid.Column="1" Minimum="0" Maximum="90" TickFrequency="1" IsSnapToTickEnabled="True"
                                            Margin="12,0" VerticalAlignment="Center" Value="{Binding Settings.BackgroundDim, Mode=TwoWay}"
                                            AutomationProperties.Name="Затемнение" />
                                    <TextBlock Grid.Column="2" Text="{Binding Settings.BackgroundDim, StringFormat={}{0}%}" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="Эффекты прозрачности" FontSize="13.5" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource SecondaryText}" FontSize="11.5" Text="Отключите, чтобы сделать модули и боковую панель непрозрачными" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                              IsChecked="{Binding Settings.TransparencyEffectsEnabled, Mode=TwoWay}"
                                              AutomationProperties.Name="Эффекты прозрачности" />
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="52" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Прозрачность модулей" FontSize="13.5" />
                                        <TextBlock Style="{StaticResource SecondaryText}" FontSize="11.5" Text="Меньше значение — сильнее просвечивает фон" />
                                    </StackPanel>
                                    <Slider Grid.Column="1" Minimum="50" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                            Margin="12,0" VerticalAlignment="Center" Value="{Binding Settings.CardOpacity, Mode=TwoWay}"
                                            AutomationProperties.Name="Прозрачность модулей" />
                                    <TextBlock Grid.Column="2" Text="{Binding Settings.CardOpacity, StringFormat={}{0}%}" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Внешний вид" FontSize="16" FontWeight="SemiBold" Margin="2,14,0,8" />
                        <Border Style="{StaticResource BorderCard}" Margin="0,0,16,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Плавные анимации" FontSize="14.5" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource SecondaryText}" FontSize="12.5" Margin="0,3,0,0" Text="Переходы между страницами, появление карточек и плавная прокрутка. Отключите на слабом ПК или удалённом рабочем столе." />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                          IsChecked="{Binding Settings.Animations, Mode=TwoWay}" AutomationProperties.Name="Плавные анимации" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource BorderCard}" Margin="0,0,16,10">
                            <StackPanel>
                                <TextBlock Text="Масштаб интерфейса" FontSize="14.5" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource SecondaryText}" FontSize="12.5" Margin="0,3,0,10"
                                           Text="Увеличьте, если текст мелкий, или уменьшите, чтобы на маленьком экране помещалось больше." />
                                <WrapPanel>
                                    <Button Content="90%" Margin="0,0,8,0" MinWidth="64" Command="{Binding Settings.SetScaleCommand}" CommandParameter="90" />
                                    <Button Content="100%" Margin="0,0,8,0" MinWidth="64" Command="{Binding Settings.SetScaleCommand}" CommandParameter="100" />
                                    <Button Content="110%" Margin="0,0,8,0" MinWidth="64" Command="{Binding Settings.SetScaleCommand}" CommandParameter="110" />
                                    <Button Content="125%" Margin="0,0,8,0" MinWidth="64" Command="{Binding Settings.SetScaleCommand}" CommandParameter="125" />
                                    <TextBlock Text="{Binding Settings.ScaleText}" VerticalAlignment="Center" Margin="8,0,0,0"
                                               Foreground="{DynamicResource AccentBrush}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Данные и диагностика" FontSize="16" FontWeight="SemiBold" Margin="2,14,0,8" />
                        <Border Style="{StaticResource BorderCard}" Margin="0,0,16,10">
                            <StackPanel>
                                <TextBlock Text="Журнал и папка данных" FontSize="14.5" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource SecondaryText}" FontSize="12.5" Margin="0,3,0,10"
                                           Text="Если что-то работает не так, приложите журнал к сообщению об ошибке. Там же лежат резервные копии значений реестра для отката твиков." />
                                <WrapPanel>
                                    <Button Content="Открыть журнал" Margin="0,0,8,0" Command="{Binding Settings.OpenLogCommand}" />
                                    <Button Content="Открыть папку данных" Margin="0,0,8,0" Command="{Binding Settings.OpenDataFolderCommand}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource BorderCard}" Margin="0,0,16,10">
                            <StackPanel>
                                <TextBlock Text="Кэш" FontSize="14.5" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Settings.CacheText}" Style="{StaticResource SecondaryText}" FontSize="12.5" Margin="0,3,0,10" />
                                <Button Content="Очистить кэш" HorizontalAlignment="Left" Command="{Binding Settings.ClearCacheCommand}"
                                        ToolTip="Резервные копии твиков и настройки не затрагиваются" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="О программе" FontSize="16" FontWeight="SemiBold" Margin="2,14,0,8" />
                        <Border Style="{StaticResource BorderCard}" Margin="0,0,16,10">
                            <StackPanel>
                                <TextBlock Text="{Binding VersionLabel, StringFormat=WinOptimizer {0}}" FontSize="14.5" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource SecondaryText}" FontSize="12.5" Margin="0,3,0,10"
                                           Text="Открытый оптимизатор Windows с лицензией MIT. Исходный код, релизы и обсуждение ошибок — на GitHub." />
                                <WrapPanel>
                                    <Button Content="Проверить обновления" Margin="0,0,8,0" Style="{StaticResource AccentButton}"
                                            Command="{Binding CheckUpdateCommand}" />
                                    <Button Content="Страница проекта" Margin="0,0,8,0" Command="{Binding OpenLinkCommand}"
                                            CommandParameter="https://github.com/reikidod/WinOptimazer" />
                                    <Button Content="Все релизы" Margin="0,0,8,0" Command="{Binding OpenLinkCommand}"
                                            CommandParameter="https://github.com/reikidod/WinOptimazer/releases" />
                                    <Button Content="Сбросить настройки" Margin="0,0,8,0" Command="{Binding Settings.ResetCommand}" />
                                </WrapPanel>
                                <TextBlock Text="{Binding UpdateStatus}" Margin="0,10,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" />
                                <TextBlock Text="{Binding Settings.Status}" Margin="0,6,0,0" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
</UserControl>
