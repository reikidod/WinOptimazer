<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Общие стили страниц. Лежат на уровне Application, а не в Window.Resources:
         MainWindowPages и SettingsPage (из WinOptimizer.Settings.dll) парсятся отдельно
         и на этапе InitializeComponent ещё не видят ресурсы окна. -->
    <Style x:Key="BorderCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BgCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource BgCardHoverBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Заголовок страницы и подзаголовок -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="SecondaryText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Небольшой «бейдж» с текстом -->
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Background" Value="#33FFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
</ResourceDictionary>
