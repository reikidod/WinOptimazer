<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:WinOptimizer.Views">

    <!-- WinOptimizer "Aurora Slate" (design system v2).
         Layers: window (deepest) -> sidebar -> card -> card hover.
         Blue is the single accent: selection, focus, primary action, progress.
         Status colours (success / warn / danger) are used only for state, never for decoration. -->
    <Color x:Key="BgWindowColor">#0E1117</Color>
    <Color x:Key="BgSidebarColor">#121620</Color>
    <Color x:Key="BgCardColor">#171C28</Color>
    <Color x:Key="BgCardHoverColor">#1E2535</Color>
    <Color x:Key="BgInputColor">#0F131B</Color>
    <Color x:Key="BorderColor">#262E3F</Color>
    <Color x:Key="BorderHoverColor">#3A4A6B</Color>
    <Color x:Key="AccentColor">#6AA6FF</Color>
    <Color x:Key="AccentStrongColor">#2F5FD0</Color>
    <Color x:Key="AccentSoftColor">#266AA6FF</Color>
    <Color x:Key="TrackOffColor">#2A3246</Color>

    <SolidColorBrush x:Key="BgWindowBrush" Color="{StaticResource BgWindowColor}" />
    <SolidColorBrush x:Key="BgSidebarBrush" Color="{StaticResource BgSidebarColor}" />
    <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource BgCardColor}" />
    <SolidColorBrush x:Key="BgCardHoverBrush" Color="{StaticResource BgCardHoverColor}" />
    <SolidColorBrush x:Key="BgInputBrush" Color="{StaticResource BgInputColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderHoverBrush" Color="{StaticResource BorderHoverColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentStrongBrush" Color="{StaticResource AccentStrongColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="TrackOffBrush" Color="{StaticResource TrackOffColor}" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />

    <!-- Brand keys kept for compatibility with existing pages; they now carry the blue-violet signature. -->
    <SolidColorBrush x:Key="BrandCyanBrush" Color="#6AA6FF" />
    <SolidColorBrush x:Key="BrandRedBrush" Color="#8B7CFF" />
    <LinearGradientBrush x:Key="BrandGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6AA6FF" Offset="0" />
        <GradientStop Color="#8B7CFF" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="BrandActionBrush" Color="#3D6FE0" />

    <!-- Compatibility resources: intentionally empty so old references stay valid. -->
    <DrawingBrush x:Key="SiteGridBrush" TileMode="None">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="#00000000" Geometry="M0,0 H1 V1 H0 Z" />
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <RadialGradientBrush x:Key="SiteCyanGlowBrush">
        <GradientStop Color="#00000000" Offset="0" />
        <GradientStop Color="#00000000" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="SiteRedGlowBrush">
        <GradientStop Color="#00000000" Offset="0" />
        <GradientStop Color="#00000000" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="SiteBlueGlowBrush">
        <GradientStop Color="#00000000" Offset="0" />
        <GradientStop Color="#00000000" Offset="1" />
    </RadialGradientBrush>
    <SolidColorBrush x:Key="SiteAccentButtonBrush" Color="#3D6FE0" />

    <!-- Text on slate surfaces (all pairs >= 4.5:1 on BgCard). -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#EAEFF8" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A4AFC4" />
    <SolidColorBrush x:Key="TextDimBrush" Color="#7C879E" />

    <SolidColorBrush x:Key="SuccessBrush" Color="#5FD39A" />
    <SolidColorBrush x:Key="WarnBrush" Color="#F0B35C" />
    <SolidColorBrush x:Key="DangerBrush" Color="#F2777A" />
    <SolidColorBrush x:Key="NeutralBrush" Color="#8591A8" />

    <!-- ===== Кнопки: радиус 8, без масштабирования/«пружины»; отклик — лёгкая подсветка ===== -->
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource BgCardHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Border x:Name="Highlight" Background="White" Opacity="0" CornerRadius="7" IsHitTestVisible="False" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Highlight" Property="Opacity" Value="0.07" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Highlight" Property="Opacity" Value="0.14" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Основное действие: заливка акцентом, рамка в тон. -->
    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource SiteAccentButtonBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SiteAccentButtonBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Effect" Value="{x:Null}" />
    </Style>

    <!-- ===== Пункт навигации: «таблетка» с мягкой акцентной заливкой у выбранного ===== -->
    <Style x:Key="NavButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Root" CornerRadius="10" Background="Transparent"
                            BorderThickness="1" BorderBrush="Transparent"
                            Padding="12,10" SnapsToDevicePixels="True">
                        <Grid>
                            <Border x:Name="Bar" Width="3" Height="18" CornerRadius="2"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Margin="-12,0,0,0"
                                    Background="{DynamicResource AccentBrush}" Opacity="0"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="BarScale" ScaleY="0.3" />
                                </Border.RenderTransform>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource BgCardHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="BarScale" Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="BarScale" Storyboard.TargetProperty="ScaleY"
                                                         To="0.3" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Поле ввода / поиск ===== -->
    <!-- Подсказка (placeholder) задаётся через Tag="Текст подсказки" -->
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentStrongBrush}" />
        <Setter Property="SelectionTextBrush" Value="White" />
        <Setter Property="Background" Value="{DynamicResource BgInputBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8" SnapsToDevicePixels="True">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden" />
                            <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}"
                                       Margin="{TemplateBinding Padding}"
                                       Foreground="{DynamicResource TextDimBrush}"
                                       VerticalAlignment="Center" IsHitTestVisible="False"
                                       TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
